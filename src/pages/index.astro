---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import Features from '../components/Features.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Flywheel from '../components/Flywheel.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout 
  title="ScaleX - Trade Smarter. Earn While You Wait."
  description="The first CLOB DEX where your open limit orders earn lending yield. Stop letting your capital sit idle—maximize your portfolio's potential."
>
  <Header />
  <main>
    <Hero />
    <ProblemSolution />
    <Features />
    <ComparisonTable />
    <Flywheel />
    <CTA />
  </main>
  <Footer />
</Layout>
