---
// Problem vs Solution — ✗/✓ checklist layout per Figma (1106:4108)
---

<section class="py-24 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-surface-primary via-surface-secondary/20 to-surface-primary pointer-events-none"></div>

  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-display font-semibold mb-6 section-gradient-text">
        Other DEXs vs ScaleX.
      </h2>
      <p class="text-lg font-body text-secondary">
        Stop Leaving Money on the Table. Every second your limit order waits,
        you're losing potential yield. <span class="text-white font-medium">ScaleX changes that.</span>
      </p>
    </div>

    <!-- Comparison Cards -->
    <div class="relative grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">

      <!-- Other DEXs Card -->
      <div class="rounded-3xl bg-surface-secondary/30 border border-white/20 p-8 flex flex-col gap-6">
        <!-- Card Header -->
        <div class="flex items-center gap-3">
          <div class="p-2.5 bg-white/5 rounded-xl">
            <svg class="w-5 h-5 text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <span class="font-heading font-bold text-xl text-white/80">Other DEXs</span>
        </div>

        <!-- Description -->
        <p class="text-sm font-body text-white/50 leading-relaxed">
          When your limit order hasn't executed, your capital just sits idle and earning nothing.
        </p>

        <hr class="border-white/10" />

        <!-- Checklist: ✗ items -->
        <ul class="flex flex-col gap-4">
          {[
            'Funds sit idle while limit orders wait',
            'No yield generated during order delay',
            'Hidden opportunity cost over time',
            'Capital locked with zero productivity',
          ].map((item) => (
            <li class="flex items-center gap-3">
              <div class="shrink-0 w-5 h-5 rounded-full bg-red-500/15 flex items-center justify-center">
                <svg class="w-3 h-3 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
              </div>
              <span class="text-sm font-body text-white/60">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- VS Badge -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 hidden md:flex">
        <div class="w-[60px] h-[60px] rounded-full bg-gradient-to-br from-primary to-primary-dark flex items-center justify-center font-heading font-bold text-white text-lg shadow-xl shadow-primary/30">
          VS
        </div>
      </div>

      <!-- ScaleX Card -->
      <div class="rounded-3xl border border-primary p-8 flex flex-col gap-6" style="background: rgba(249,115,22,0.08);">
        <!-- Card Header -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="p-2.5 bg-primary rounded-xl">
              <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <span class="font-heading font-bold text-xl text-white">ScaleX</span>
          </div>
          <span class="flex h-3 w-3 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-primary"></span>
          </span>
        </div>

        <!-- Description -->
        <p class="text-sm font-body text-white/70 leading-relaxed">
          Instead of sitting idle, ScaleX puts your liquidity to work and generating passive yield.
        </p>

        <hr class="border-primary/30" />

        <!-- Checklist: ✓ items -->
        <ul class="flex flex-col gap-4">
          {[
            'Earn yield while waiting',
            'Up to +12.5% APY on idle capital',
            'Turn idle into passive income',
            'More efficient, capital-optimized trading',
          ].map((item) => (
            <li class="flex items-center gap-3">
              <div class="shrink-0 w-5 h-5 rounded-full bg-success-light/15 flex items-center justify-center">
                <svg class="w-3 h-3 text-success-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <path d="M20 6 9 17l-5-5"/>
                </svg>
              </div>
              <span class="text-sm font-body text-white/80">{item}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .section-gradient-text {
    background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0.6) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
