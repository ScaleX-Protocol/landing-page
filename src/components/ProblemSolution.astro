---
// Problem vs Solution comparison section
---

<section class="py-24 relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-b from-surface-primary via-surface-secondary/50 to-surface-primary pointer-events-none"></div>

  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 space-y-4">
      <h2>Problem vs. <span class="gradient-text">Solution</span></h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        See why traders are switching to ScaleX. Unlock the true potential of your capital with our efficiency engine.
      </p>
    </div>

    <!-- Comparison Cards -->
    <div class="relative grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- Traditional DEX Card -->
      <div class="card bg-surface-tertiary/50 space-y-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="p-2 bg-gray-800 rounded-lg">
              <svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </div>
            <span class="font-heading font-semibold text-lg text-white">Traditional DEX</span>
          </div>
          <span class="badge text-xs">THE OLD WAY</span>
        </div>

        <!-- Chart Placeholder - Flat Line -->
        <div class="h-32 bg-surface-primary rounded-xl flex items-center justify-center relative overflow-hidden">
          <div class="absolute inset-0 flex items-end justify-center p-4">
            <div class="w-full h-1 bg-gray-700 rounded"></div>
          </div>
          <div class="flex flex-col items-center gap-2 z-10">
            <svg class="w-10 h-10 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span class="text-sm text-gray-500">Idle Capital</span>
          </div>
        </div>

        <!-- Stats -->
        <div class="space-y-4 pt-4 border-t border-border">
          <div class="flex justify-between items-center">
            <span class="text-gray-400">Limit Orders</span>
            <span class="font-heading font-semibold text-white">$50,000</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-400">Yield Generated</span>
            <span class="font-heading font-semibold text-gray-500">$0 Yield</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-400">Status</span>
            <span class="flex items-center gap-2 text-red-500 font-medium">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
              </svg>
              Capital is frozen
            </span>
          </div>
        </div>
      </div>

      <!-- VS Badge -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 hidden md:flex">
        <div class="w-14 h-14 rounded-full bg-surface-primary border-2 border-border flex items-center justify-center font-heading font-bold text-lg shadow-xl">
          VS
        </div>
      </div>

      <!-- ScaleX Card -->
      <div class="card-glow space-y-6 ring-1 ring-primary/20">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="p-2 bg-primary/20 rounded-lg">
              <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <span class="font-heading font-semibold text-lg text-white">ScaleX</span>
          </div>
          <span class="badge badge-live text-xs">THE SCALEX WAY</span>
        </div>

        <!-- Chart Placeholder - Growing Bars -->
        <div class="h-32 bg-surface-primary rounded-xl flex items-end justify-center gap-3 p-4 relative overflow-hidden">
          <div class="absolute top-2 right-3">
            <span class="flex items-center gap-1 text-xs font-medium">
              <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
              <span class="text-primary">EARNING</span>
            </span>
          </div>
          <div class="w-8 h-8 bg-primary/60 rounded-t"></div>
          <div class="w-8 h-12 bg-primary/70 rounded-t"></div>
          <div class="w-8 h-16 bg-primary/80 rounded-t"></div>
          <div class="w-8 h-24 bg-primary rounded-t"></div>
        </div>

        <!-- Stats -->
        <div class="space-y-4 pt-4 border-t border-primary/20">
          <div class="flex justify-between items-center">
            <span class="text-gray-400">Limit Orders</span>
            <span class="font-heading font-semibold text-white">Same $50,000</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-400">Yield Generated</span>
            <span class="font-heading font-semibold">
              <span class="text-white">Trading Upside</span>
              <span class="text-primary"> + Lending APY</span>
            </span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-400">Status</span>
            <span class="flex items-center gap-2 text-primary font-medium">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/>
                <circle cx="12" cy="12" r="8" stroke-dasharray="4"/>
              </svg>
              Capital works 24/7
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-12 space-y-4">
      <a href="https://app.scalex.finance" class="btn-primary">
        Start Earning Now
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <p class="text-sm text-gray-500">No lock-up periods. Withdraw anytime.</p>
    </div>
  </div>
</section>
