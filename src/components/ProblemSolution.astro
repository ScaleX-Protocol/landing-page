---
// Problem vs Solution - Highlighting ScaleX advantage
---

<section class="py-24 relative overflow-hidden">
  <!-- Background -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-surface-primary via-surface-secondary/20 to-surface-primary pointer-events-none"
  >
  </div>

  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6">
        Stop Leaving Money on the Table
      </h2>
      <p class="text-lg text-gray-400">
        Every second your limit order waits, you're losing potential yield.
        <span class="text-white font-medium">ScaleX changes that.</span>
      </p>
    </div>

    <!-- Comparison Cards -->
    <div class="relative grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- Traditional DEX Card - Dimmed Look -->
      <div
        class="group rounded-3xl bg-surface-tertiary/20 border border-white/5 p-8 relative overflow-hidden transition-all duration-500 hover:bg-surface-tertiary/30"
      >
        <!-- Grayscale Overlay -->
        <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>

        <div class="relative z-10 flex flex-col h-full">
          <div class="flex items-center gap-3 mb-8 opacity-70">
            <div class="p-2.5 bg-gray-800 rounded-xl">
              <svg
                class="w-6 h-6 text-gray-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <span class="font-heading font-bold text-xl text-gray-400"
              >Other DEXs</span
            >
          </div>

          <!-- Visual Metaphor -->
          <div class="flex-1 flex items-center justify-center py-8">
            <div class="flex flex-col items-center gap-3 text-gray-500">
              <svg
                class="w-16 h-16 opacity-50"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span class="text-sm font-medium">Funds sitting idle</span>
            </div>
          </div>

          <!-- Stats - Negative -->
          <div class="space-y-4 pt-8 border-t border-white/5">
            <div class="flex justify-between items-center">
              <span class="text-gray-500">Yield earned</span>
              <span
                class="font-heading font-bold text-gray-500 flex items-center gap-2"
              >
                $0.00
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-500">Opportunity cost</span>
              <span
                class="font-bold text-red-500/80 bg-red-500/10 px-3 py-1 rounded-full text-sm"
                >-$6,250/year</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- VS Badge -->
      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 hidden md:flex"
      >
        <div
          class="w-14 h-14 rounded-full bg-surface-primary border-4 border-surface-tertiary flex items-center justify-center font-heading font-black text-gray-600 shadow-xl"
        >
          VS
        </div>
      </div>

      <!-- ScaleX Card - Highlighted -->
      <div
        class="group rounded-3xl bg-gradient-to-br from-surface-secondary via-surface-secondary to-primary/10 border border-primary/40 p-1 relative overflow-hidden shadow-2xl hover:shadow-primary/20 transition-all duration-500 hover:-translate-y-1"
      >
        <div
          class="bg-surface-secondary/90 rounded-[22px] p-7 h-full flex flex-col backdrop-blur-sm"
        >
          <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-3">
              <div
                class="p-2.5 bg-primary rounded-xl text-white shadow-lg shadow-primary/30"
              >
                <svg
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <span class="font-heading font-bold text-xl text-white"
                >ScaleX</span
              >
            </div>
            <span class="flex h-3 w-3 relative">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
              ></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-primary"
              ></span>
            </span>
          </div>

          <!-- Visual Metaphor - Active -->
          <div class="flex-1 flex items-end justify-center py-6 gap-2">
            <div
              class="w-8 bg-primary/20 rounded-t-lg h-12 relative overflow-hidden"
            >
              <div
                class="absolute bottom-0 w-full bg-primary h-full animate-[grow_2s_ease-in-out_infinite] opacity-50"
              >
              </div>
            </div>
            <div
              class="w-8 bg-primary/20 rounded-t-lg h-20 relative overflow-hidden"
            >
              <div
                class="absolute bottom-0 w-full bg-primary h-full animate-[grow_2s_ease-in-out_0.2s_infinite] opacity-70"
              >
              </div>
            </div>
            <div
              class="w-8 bg-primary/20 rounded-t-lg h-28 relative overflow-hidden"
            >
              <div
                class="absolute bottom-0 w-full bg-primary h-full animate-[grow_2s_ease-in-out_0.4s_infinite]"
              >
              </div>
            </div>
            <div
              class="w-8 bg-primary/20 rounded-t-lg h-16 relative overflow-hidden"
            >
              <div
                class="absolute bottom-0 w-full bg-primary h-full animate-[grow_2s_ease-in-out_0.6s_infinite] opacity-60"
              >
              </div>
            </div>
          </div>

          <!-- Stats - Positive -->
          <div class="space-y-4 pt-8 border-t border-primary/20">
            <div class="flex justify-between items-center">
              <span class="text-gray-300">Yield earned</span>
              <span class="font-heading font-bold text-primary text-lg">
                +12.5% APY
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-300">Extra profit</span>
              <span
                class="font-bold text-green-400 bg-green-400/10 px-3 py-1 rounded-full text-sm"
                >+$6,250/year</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes grow {
    0%,
    100% {
      height: 30%;
    }
    50% {
      height: 100%;
    }
  }
</style>
