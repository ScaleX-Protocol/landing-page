---
// Comparison Table - Why ScaleX Wins
const features = [
  {
    name: "Yield on Open Orders",
    scalex: { value: "Yes", detail: "Earn while waiting", positive: true },
    dex: { value: "No", positive: false },
    lending: { value: "No", positive: false }
  },
  {
    name: "Capital Efficiency",
    scalex: { value: "High", detail: "10x Leverage", positive: true },
    dex: { value: "Medium", positive: null },
    lending: { value: "Low", detail: "Over-collateralized", positive: false }
  },
  {
    name: "Liquidation Type",
    scalex: { value: "Soft Liquidations", positive: true, highlight: true },
    dex: { value: "Hard Liquidations", positive: false },
    lending: { value: "Hard Liquidations", positive: false }
  },
  {
    name: "Repayment",
    scalex: { value: "Auto-repay via Yield", positive: true, icon: "magic" },
    dex: { value: "Manual", positive: null },
    lending: { value: "Manual", positive: null }
  }
];
---

<section class="py-24 relative overflow-hidden" id="markets">
  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 space-y-4">
      <h2>Why <span class="gradient-text">ScaleX</span> Wins</h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        Compare us with standard <span class="text-primary">DEXs</span> and <span class="text-primary">lending protocols</span>. 
        See how we unlock capital efficiency and maximize your yield in the DeFi ecosystem.
      </p>
    </div>

    <!-- Comparison Table -->
    <div class="max-w-4xl mx-auto overflow-x-auto">
      <table class="w-full">
        <!-- Header -->
        <thead>
          <tr class="border-b border-border">
            <th class="text-left py-4 px-4 text-sm text-gray-500 uppercase tracking-wider font-medium">Feature</th>
            <th class="text-center py-4 px-4 relative">
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <span class="bg-primary text-white text-xs font-bold px-3 py-1 rounded-full uppercase">Recommended</span>
              </div>
              <div class="flex items-center justify-center gap-2 pt-4">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 48 48" fill="currentColor">
                  <path d="M8 12L24 4L40 12V20L32 24L40 28V36L24 44L8 36V28L16 24L8 20V12Z"/>
                </svg>
                <span class="font-heading font-bold text-white">ScaleX</span>
              </div>
            </th>
            <th class="text-center py-4 px-4">
              <div class="text-gray-400 font-heading font-semibold">Standard DEX</div>
              <div class="text-xs text-gray-500">(dYdX)</div>
            </th>
            <th class="text-center py-4 px-4">
              <div class="text-gray-400 font-heading font-semibold">Lending</div>
              <div class="text-xs text-gray-500">(Aave)</div>
            </th>
          </tr>
        </thead>
        
        <!-- Body -->
        <tbody>
          {features.map((feature, index) => (
            <tr class={`border-b border-border/50 hover:bg-surface-secondary/50 transition-colors ${index % 2 === 0 ? 'bg-surface-secondary/20' : ''}`}>
              <td class="py-5 px-4">
                <div class="flex items-center gap-2">
                  <span class="font-medium text-white">{feature.name}</span>
                  <button class="text-gray-600 hover:text-gray-400 transition-colors">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/>
                      <path d="M12 16v-4M12 8h.01"/>
                    </svg>
                  </button>
                </div>
              </td>
              <td class="py-5 px-4 text-center bg-primary/5">
                <div class="flex flex-col items-center gap-1">
                  <div class="flex items-center gap-2">
                    {feature.scalex.positive && (
                      <svg class="w-5 h-5 text-success" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    )}
                    {feature.scalex.icon === "magic" && (
                      <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15 4V2M15 16v-2M8 9h2M20 9h2M17.8 11.8L19 13M17.8 6.2L19 5M3 21l9-9"/>
                      </svg>
                    )}
                    <span class={`font-semibold ${feature.scalex.positive ? 'text-success' : 'text-white'}`}>
                      {feature.scalex.value}
                    </span>
                  </div>
                  {feature.scalex.detail && (
                    <span class={`text-xs ${feature.scalex.highlight ? 'bg-primary/20 text-primary px-2 py-0.5 rounded-full' : 'text-primary'}`}>
                      {feature.scalex.detail}
                    </span>
                  )}
                </div>
              </td>
              <td class="py-5 px-4 text-center">
                <div class="flex items-center justify-center gap-2">
                  {feature.dex.positive === false && (
                    <svg class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/>
                      <path d="M15 9l-6 6M9 9l6 6"/>
                    </svg>
                  )}
                  <span class={`${feature.dex.positive === false ? 'text-gray-500' : 'text-gray-400'}`}>
                    {feature.dex.value}
                  </span>
                </div>
              </td>
              <td class="py-5 px-4 text-center">
                <div class="flex flex-col items-center gap-1">
                  <div class="flex items-center justify-center gap-2">
                    {feature.lending.positive === false && (
                      <svg class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M15 9l-6 6M9 9l6 6"/>
                      </svg>
                    )}
                    <span class={`${feature.lending.positive === false ? 'text-gray-500' : 'text-gray-400'}`}>
                      {feature.lending.value}
                    </span>
                  </div>
                  {feature.lending.detail && (
                    <span class="text-xs text-gray-600">{feature.lending.detail}</span>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a href="https://app.scalex.finance" class="btn-primary uppercase tracking-wider">
        Start Trading
      </a>
    </div>
  </div>
</section>
