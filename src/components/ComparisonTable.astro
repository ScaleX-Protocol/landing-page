---
// Comparison Table - Why ScaleX Wins with tooltips
const features = [
  {
    name: "Yield on Open Orders",
    tooltip: "Earn lending interest on the capital locked in your limit orders while waiting for execution.",
    scalex: { value: "Yes", detail: "12.5% avg APY", positive: true },
    dex: { value: "No", positive: false },
    lending: { value: "No", positive: false },
  },
  {
    name: "Borrow from Portfolio",
    tooltip: "Borrow against your assets without moving them between protocols or wallets.",
    scalex: { value: "1-Click", detail: "No asset transfer", positive: true },
    dex: { value: "No", positive: false },
    lending: { value: "Multi-step", detail: "Transfer required", positive: false },
  },
  {
    name: "Capital Efficiency",
    tooltip: "How much trading power you get per dollar deposited. Higher is better.",
    scalex: { value: "10x", detail: "Leverage", positive: true },
    dex: { value: "5x", positive: null },
    lending: { value: "1.5x", detail: "Over-collateralized", positive: false },
  },
  {
    name: "Liquidation Protection",
    tooltip: "How the protocol handles positions that approach liquidation threshold.",
    scalex: { value: "Gradual", detail: "Soft liquidation", positive: true },
    dex: { value: "Instant", positive: false },
    lending: { value: "Instant", positive: false },
  },
  {
    name: "Loan Repayment",
    tooltip: "How outstanding loans are paid back over time.",
    scalex: { value: "Automatic", detail: "Yield pays debt", positive: true },
    dex: { value: "Manual", positive: null },
    lending: { value: "Manual", positive: null },
  },
];
---

<section class="py-24 relative overflow-hidden" id="compare">
  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6">
        The ScaleX Advantage
      </h2>
      <p class="text-lg text-gray-400">
        See how we stack up against traditional DEXs and lending protocols.
      </p>
    </div>

    <!-- Comparison Table -->
    <div class="max-w-4xl mx-auto overflow-x-auto">
      <table class="w-full border-collapse">
        <!-- Header -->
        <thead>
          <tr>
            <th class="text-left py-6 px-6 text-sm text-gray-400 uppercase tracking-wider font-medium border-b border-border/50">
              Feature
            </th>
            <th class="text-center py-6 px-6 relative border-b border-primary/20">
              <div class="absolute inset-x-0 top-0 h-1 bg-primary"></div>
              <div class="absolute inset-0 bg-primary/5 -z-10"></div>
              <div class="flex items-center justify-center gap-2">
                <div class="p-1.5 bg-primary rounded-lg text-white shadow-lg">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                     <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <span class="font-heading font-bold text-lg text-white">ScaleX</span>
              </div>
            </th>
            <th class="text-center py-6 px-6 border-b border-border/50">
              <div class="text-gray-500 font-heading font-medium">Standard DEX</div>
            </th>
            <th class="text-center py-6 px-6 border-b border-border/50">
              <div class="text-gray-500 font-heading font-medium">Lending Protocol</div>
            </th>
          </tr>
        </thead>

        <!-- Body -->
        <tbody>
          {features.map((feature, index) => (
            <tr class="group">
              <!-- Feature Name -->
              <td class="py-5 px-6 border-b border-white/5 group-hover:bg-white/[0.02] transition-colors">
                <div class="flex items-center gap-2">
                  <span class="font-medium text-gray-300 group-hover:text-white transition-colors">{feature.name}</span>
                  <div class="relative group/tooltip">
                    <button class="text-gray-600 hover:text-primary transition-colors cursor-help">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 16v-4M12 8h.01" />
                      </svg>
                    </button>
                    <!-- Tooltip -->
                    <div class="absolute left-0 bottom-full mb-2 w-64 p-3 bg-surface-tertiary border border-border rounded-xl shadow-xl opacity-0 invisible group-hover/tooltip:opacity-100 group-hover/tooltip:visible transition-all duration-200 z-50 transform translate-y-2 group-hover/tooltip:translate-y-0">
                      <p class="text-sm text-gray-300 leading-relaxed">{feature.tooltip}</p>
                      <div class="absolute left-4 bottom-0 translate-y-full w-0 h-0 border-l-8 border-r-8 border-t-8 border-transparent border-t-surface-tertiary"></div>
                    </div>
                  </div>
                </div>
              </td>
              
              <!-- ScaleX Column (Highlighted) -->
              <td class="py-5 px-6 text-center bg-primary/[0.03] border-b border-primary/10 group-hover:bg-primary/[0.06] transition-colors relative">
                <div class="absolute inset-y-0 left-0 w-px bg-primary/10"></div>
                <div class="absolute inset-y-0 right-0 w-px bg-primary/10"></div>
                
                <div class="flex flex-col items-center gap-1">
                  <div class="flex items-center gap-2 text-white">
                    {feature.scalex.positive && (
                      <div class="w-5 h-5 rounded-full bg-green-500/20 flex items-center justify-center text-green-400">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </div>
                    )}
                    <span class={`font-bold ${feature.scalex.positive ? "text-white" : "text-gray-400"}`}>
                      {feature.scalex.value}
                    </span>
                  </div>
                  {feature.scalex.detail && (
                    <span class="text-xs font-medium text-primary/80 bg-primary/10 px-2 py-0.5 rounded-full border border-primary/20">{feature.scalex.detail}</span>
                  )}
                </div>
              </td>
              
              <!-- DEX Column -->
              <td class="py-5 px-6 text-center border-b border-white/5 group-hover:bg-white/[0.02] transition-colors">
                <div class="flex items-center justify-center gap-1.5 grayscale opacity-60">
                  {feature.dex.positive === false && (
                    <svg class="w-5 h-5 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M18 6L6 18M6 6l12 12"></path>
                    </svg>
                  )}
                  <span class="text-gray-400 font-medium">{feature.dex.value}</span>
                </div>
              </td>
              
              <!-- Lending Column -->
              <td class="py-5 px-6 text-center border-b border-white/5 group-hover:bg-white/[0.02] transition-colors">
                 <div class="flex flex-col items-center gap-1 grayscale opacity-60">
                   <div class="flex items-center justify-center gap-1.5">
                     {feature.lending.positive === false && (
                      <svg class="w-5 h-5 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 6L6 18M6 6l12 12"></path>
                      </svg>
                     )}
                     <span class="text-gray-400 font-medium">{feature.lending.value}</span>
                   </div>
                   {feature.lending.detail && (
                     <span class="text-xs text-gray-500">{feature.lending.detail}</span>
                   )}
                 </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
