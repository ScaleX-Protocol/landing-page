---
// Comparison Table - Why ScaleX Wins with tooltips
const features = [
  {
    name: "Yield on Open Orders",
    tooltip: "Earn lending interest on the capital locked in your limit orders while waiting for execution.",
    scalex: { value: "Yes", detail: "12.5% avg APY", positive: true },
    dex: { value: "No", positive: false },
    lending: { value: "No", positive: false },
  },
  {
    name: "Capital Efficiency",
    tooltip: "How much trading power you get per dollar deposited. Higher is better.",
    scalex: { value: "10x", detail: "Leverage", positive: true },
    dex: { value: "5x", positive: null },
    lending: { value: "1.5x", detail: "Over-collateralized", positive: false },
  },
  {
    name: "Liquidation Protection",
    tooltip: "How the protocol handles positions that approach liquidation threshold.",
    scalex: { value: "Gradual", detail: "Soft liquidation", positive: true },
    dex: { value: "Instant", positive: false },
    lending: { value: "Instant", positive: false },
  },
  {
    name: "Loan Repayment",
    tooltip: "How outstanding loans are paid back over time.",
    scalex: { value: "Automatic", detail: "Yield pays debt", positive: true },
    dex: { value: "Manual", positive: null },
    lending: { value: "Manual", positive: null },
  },
];
---

<section class="py-24 relative overflow-hidden" id="compare">
  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6">
        The ScaleX Advantage
      </h2>
      <p class="text-lg text-gray-400">
        See how we stack up against traditional DEXs and lending protocols.
      </p>
    </div>

    <!-- Comparison Table -->
    <div class="max-w-4xl mx-auto overflow-x-auto">
      <table class="w-full">
        <!-- Header -->
        <thead>
          <tr class="border-b border-border">
            <th class="text-left py-5 px-4 text-sm text-gray-500 uppercase tracking-wider font-medium">
              Feature
            </th>
            <th class="text-center py-5 px-4">
              <div class="flex items-center justify-center gap-2">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 48 48" fill="currentColor">
                  <path d="M8 12L24 4L40 12V20L32 24L40 28V36L24 44L8 36V28L16 24L8 20V12Z"></path>
                </svg>
                <span class="font-heading font-bold text-primary">ScaleX</span>
              </div>
            </th>
            <th class="text-center py-5 px-4">
              <div class="text-gray-500 font-heading font-medium">DEX</div>
            </th>
            <th class="text-center py-5 px-4">
              <div class="text-gray-500 font-heading font-medium">Lending</div>
            </th>
          </tr>
        </thead>

        <!-- Body -->
        <tbody>
          {features.map((feature, index) => (
            <tr class={`border-b border-border/30 hover:bg-surface-secondary/30 transition-colors ${index % 2 === 0 ? "bg-surface-secondary/10" : ""}`}>
              <td class="py-5 px-4">
                <div class="flex items-center gap-2">
                  <span class="font-medium text-white">{feature.name}</span>
                  <div class="relative group">
                    <button class="text-gray-600 hover:text-primary transition-colors">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 16v-4M12 8h.01" />
                      </svg>
                    </button>
                    <!-- Tooltip -->
                    <div class="absolute left-0 bottom-full mb-2 w-64 p-3 bg-surface-tertiary border border-border rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                      <p class="text-sm text-gray-300 leading-relaxed">{feature.tooltip}</p>
                      <div class="absolute left-4 bottom-0 translate-y-full w-0 h-0 border-l-8 border-r-8 border-t-8 border-transparent border-t-surface-tertiary"></div>
                    </div>
                  </div>
                </div>
              </td>
              <td class="py-5 px-4 text-center bg-primary/5">
                <div class="flex flex-col items-center gap-0.5">
                  <div class="flex items-center gap-1.5">
                    {feature.scalex.positive && (
                      <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    )}
                    <span class={`font-semibold ${feature.scalex.positive ? "text-primary" : "text-white"}`}>
                      {feature.scalex.value}
                    </span>
                  </div>
                  {feature.scalex.detail && (
                    <span class="text-xs text-primary/80">{feature.scalex.detail}</span>
                  )}
                </div>
              </td>
              <td class="py-5 px-4 text-center">
                <div class="flex items-center justify-center gap-1.5">
                  {feature.dex.positive === false && (
                    <svg class="w-4 h-4 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M15 9l-6 6M9 9l6 6" />
                    </svg>
                  )}
                  <span class="text-gray-500">{feature.dex.value}</span>
                </div>
              </td>
              <td class="py-5 px-4 text-center">
                <div class="flex flex-col items-center gap-0.5">
                  <div class="flex items-center justify-center gap-1.5">
                    {feature.lending.positive === false && (
                      <svg class="w-4 h-4 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M15 9l-6 6M9 9l6 6" />
                      </svg>
                    )}
                    <span class="text-gray-500">{feature.lending.value}</span>
                  </div>
                  {feature.lending.detail && (
                    <span class="text-xs text-gray-600">{feature.lending.detail}</span>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
