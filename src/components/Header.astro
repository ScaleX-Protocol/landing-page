---
// Header component with ScaleX logo and navigation
import scaleXLogo from "../assets/images/ScaleX.webp";
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-surface-primary/80 backdrop-blur-xl border-b border-border/50"
>
  <div class="section-container">
    <nav class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <img src={scaleXLogo.src} alt="ScaleX Logo" class="w-12 h-12" />
        <span class="text-xl md:text-2xl font-heading font-bold text-white"
          >ScaleX</span
        >
      </a>

      <!-- CTA Button -->
      <div class="flex items-center gap-4">
        <a
          href="https://mantle-sepolia-app.scalex.money"
          target="_blank"
          rel="noopener"
          class="btn-primary text-sm md:text-base"
        >
          <!-- <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg> -->
          Launch App
        </a>
      </div>
    </nav>
  </div>
</header>
