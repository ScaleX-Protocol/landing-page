---
// Header component with ScaleX logo and navigation
import scaleXLogo from "../assets/images/ScaleX-Logo.png";
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  id="site-header"
>
  <div class="max-w-[1440px] mx-auto">
    <nav class="flex items-center justify-between px-8 lg:px-[60px] py-6">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-1.5 group z-10">
        <img src={scaleXLogo.src} alt="ScaleX Logo" class="w-12 h-12" />
        <span class="text-2xl font-heading font-bold text-white leading-8">ScaleX</span>
      </a>

      <!-- Nav Links (center) -->
      <div class="hidden lg:flex items-center gap-6 z-10">
        <a
          href="#features"
          class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors"
        >Features</a>
        <a
          href="#flywheel"
          class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors"
        >How it works</a>
        <a
          href="https://docs.scalex.money"
          target="_blank"
          rel="noopener"
          class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors"
        >Docs</a>
        <a
          href="https://x.com/ScaleX_money"
          target="_blank"
          rel="noopener"
          class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors"
        >Community</a>
        <a
          href="#"
          class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors"
        >Blog</a>
      </div>

      <!-- Right CTA -->
      <div class="flex items-center gap-6 z-10">
        <!-- Language Selector -->
        <div
          class="hidden md:flex items-center gap-1 cursor-pointer text-white hover:text-primary transition-colors"
        >
          <svg
            class="w-6 h-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path
              d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          <span class="text-base font-body font-medium leading-6 tracking-[-1%]">EN</span>
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </div>

        <!-- Launch App Button -->
        <a
          href="https://base-sepolia-app.scalex.money"
          target="_blank"
          rel="noopener"
          class="btn-primary text-base"
        >
          Launch App
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Header scroll effect
  const header = document.getElementById("site-header");
  if (header) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        header.classList.add(
          "bg-surface-primary/80",
          "backdrop-blur-xl",
          "border-b",
          "border-white/5",
        );
      } else {
        header.classList.remove(
          "bg-surface-primary/80",
          "backdrop-blur-xl",
          "border-b",
          "border-white/5",
        );
      }
    });
  }
</script>
