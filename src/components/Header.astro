---
// Header component with ScaleX logo, navigation, and language switcher
import scaleXLogo from "../assets/images/ScaleX-Logo.png";
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  id="site-header"
>
  <div class="max-w-[1440px] mx-auto">
    <nav class="flex items-center justify-between px-4 sm:px-8 lg:px-[60px] py-6">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-1.5 group z-10">
        <img src={scaleXLogo.src} alt="ScaleX Logo" class="w-12 h-12" />
        <span class="text-2xl font-heading font-bold text-white leading-8">ScaleX</span>
      </a>

      <!-- Nav Links (center) -->
      <div class="hidden lg:flex items-center gap-6 z-10">
        <a href="#features" class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors" data-i18n="nav.features">Features</a>
        <a href="#flywheel" class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors" data-i18n="nav.howItWorks">How it works</a>
        <a href="https://docs.scalex.money" target="_blank" rel="noopener" class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors" data-i18n="nav.docs">Docs</a>
        <a href="https://x.com/ScaleX_money" target="_blank" rel="noopener" class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors" data-i18n="nav.community">Community</a>
        <a href="#" class="text-white text-base font-body font-normal leading-6 tracking-[-1%] hover:text-primary transition-colors" data-i18n="nav.blog">Blog</a>
      </div>

      <!-- Right CTA -->
      <div class="flex items-center gap-4 sm:gap-6 z-10">
        <!-- Language Selector -->
        <div class="hidden md:block relative" id="lang-selector">
          <button
            class="flex items-center gap-1.5 cursor-pointer text-white hover:text-primary transition-colors py-1.5 px-2 rounded-lg hover:bg-white/5"
            id="lang-toggle"
            type="button"
            aria-expanded="false"
            aria-haspopup="listbox"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span class="text-sm font-body font-medium leading-5 tracking-[-1%]" id="lang-current">EN</span>
            <svg class="w-4 h-4 transition-transform duration-200" id="lang-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>

          <!-- Dropdown -->
          <div
            class="absolute right-0 top-full mt-2 w-[160px] rounded-xl border border-white/10 overflow-hidden opacity-0 invisible translate-y-1 transition-all duration-200"
            style="background: rgba(10, 10, 10, 0.95); backdrop-filter: blur(20px);"
            id="lang-dropdown"
            role="listbox"
          >
            <button class="lang-option w-full flex items-center gap-3 px-4 py-2.5 text-left hover:bg-white/5 transition-colors" data-lang="en" role="option">
              <span class="text-xs font-body font-bold text-primary/80 w-6">EN</span>
              <span class="text-sm font-body text-white/80">English</span>
            </button>
            <button class="lang-option w-full flex items-center gap-3 px-4 py-2.5 text-left hover:bg-white/5 transition-colors" data-lang="id" role="option">
              <span class="text-xs font-body font-bold text-white/40 w-6">ID</span>
              <span class="text-sm font-body text-white/80">Indonesia</span>
            </button>
            <button class="lang-option w-full flex items-center gap-3 px-4 py-2.5 text-left hover:bg-white/5 transition-colors" data-lang="zh" role="option">
              <span class="text-xs font-body font-bold text-white/40 w-6">ZH</span>
              <span class="text-sm font-body text-white/80">中文</span>
            </button>
            <button class="lang-option w-full flex items-center gap-3 px-4 py-2.5 text-left hover:bg-white/5 transition-colors" data-lang="ja" role="option">
              <span class="text-xs font-body font-bold text-white/40 w-6">JA</span>
              <span class="text-sm font-body text-white/80">日本語</span>
            </button>
          </div>
        </div>

        <!-- Launch App Button -->
        <a
          href="https://base-sepolia-app.scalex.money"
          target="_blank"
          rel="noopener"
          class="btn-primary text-sm sm:text-base"
          data-i18n="nav.launchApp"
        >
          Launch App
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Header scroll effect
  const header = document.getElementById("site-header");
  if (header) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        header.classList.add("bg-surface-primary/80", "backdrop-blur-xl", "border-b", "border-white/5");
      } else {
        header.classList.remove("bg-surface-primary/80", "backdrop-blur-xl", "border-b", "border-white/5");
      }
    });
  }

  // Language dropdown
  const toggle = document.getElementById("lang-toggle");
  const dropdown = document.getElementById("lang-dropdown");
  const chevron = document.getElementById("lang-chevron");
  const currentLabel = document.getElementById("lang-current");
  let isOpen = false;

  function openDropdown() {
    isOpen = true;
    dropdown?.classList.remove("opacity-0", "invisible", "translate-y-1");
    dropdown?.classList.add("opacity-100", "visible", "translate-y-0");
    chevron?.classList.add("rotate-180");
    toggle?.setAttribute("aria-expanded", "true");
  }

  function closeDropdown() {
    isOpen = false;
    dropdown?.classList.add("opacity-0", "invisible", "translate-y-1");
    dropdown?.classList.remove("opacity-100", "visible", "translate-y-0");
    chevron?.classList.remove("rotate-180");
    toggle?.setAttribute("aria-expanded", "false");
  }

  toggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    isOpen ? closeDropdown() : openDropdown();
  });

  document.addEventListener("click", (e) => {
    const selector = document.getElementById("lang-selector");
    if (selector && !selector.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // Language selection
  const langOptions = document.querySelectorAll(".lang-option");
  const currentLang = localStorage.getItem("scalex-lang") || "en";

  // Highlight active lang on load
  updateActiveLang(currentLang);

  langOptions.forEach((btn) => {
    btn.addEventListener("click", () => {
      const lang = (btn as HTMLElement).dataset.lang || "en";
      localStorage.setItem("scalex-lang", lang);
      updateActiveLang(lang);
      closeDropdown();

      // Dispatch custom event for future i18n integration
      window.dispatchEvent(new CustomEvent("lang-change", { detail: { lang } }));
    });
  });

  function updateActiveLang(lang: string) {
    if (currentLabel) {
      currentLabel.textContent = lang.toUpperCase();
    }
    langOptions.forEach((btn) => {
      const btnLang = (btn as HTMLElement).dataset.lang;
      const codeSpan = btn.querySelector("span:first-child");
      if (codeSpan) {
        if (btnLang === lang) {
          codeSpan.classList.remove("text-white/40");
          codeSpan.classList.add("text-primary/80");
        } else {
          codeSpan.classList.add("text-white/40");
          codeSpan.classList.remove("text-primary/80");
        }
      }
    });
  }
</script>
