---
// Footer component matching the reference design
import scaleXLogo from "../assets/images/ScaleX.webp";
---

<footer class="py-10 lg:py-20" style="background-color: #050505;">
  <div class="max-w-[1200px] mx-auto px-8 lg:px-[120px]">
    <!-- Horizontal Rule -->
    <div class="w-full h-px bg-white/10 mb-10"></div>

    <!-- Top Section: Tagline + Links -->
    <div class="flex flex-col lg:flex-row items-start gap-6 mb-10">
      <!-- Left: Tagline -->
      <div class="flex-1">
        <p class="text-sm text-gray-500 leading-relaxed max-w-md">
          The capital efficient DeFi trading protocol bridging the gap between
          lending and derivatives.
        </p>
      </div>

      <!-- Vertical Separator -->
      <div class="hidden lg:block w-px self-stretch bg-white/10"></div>

      <!-- Right: Link Rows -->
      <div class="flex-1 flex flex-col gap-3 w-full">
        <a
          href="mailto:team@scalex.money"
          class="flex items-center justify-between py-2 group cursor-pointer"
        >
          <span
            class="text-[#CACACA] text-lg font-body font-normal leading-7 group-hover:text-white transition-colors"
            >Contact us</span
          >
          <svg
            class="w-6 h-6 text-gray-500 group-hover:text-white transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
        <div class="w-full h-px bg-white/10"></div>

        <a
          href="https://docs.scalex.money"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between py-2 group cursor-pointer"
        >
          <span
            class="text-[#CACACA] text-lg font-body font-normal leading-7 group-hover:text-white transition-colors"
            >Documentation</span
          >
          <svg
            class="w-6 h-6 text-gray-500 group-hover:text-white transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
        <div class="w-full h-px bg-white/10"></div>

        <a
          href="https://x.com/ScaleX_money"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between py-2 group cursor-pointer"
        >
          <span
            class="text-[#CACACA] text-lg font-body font-normal leading-7 group-hover:text-white transition-colors"
            >Twitter Community</span
          >
          <svg
            class="w-6 h-6 text-gray-500 group-hover:text-white transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
        <div class="w-full h-px bg-white/10"></div>

        <a
          href="https://github.com/ScaleX-Protocol"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between py-2 group cursor-pointer"
        >
          <span
            class="text-[#CACACA] text-lg font-body font-normal leading-7 group-hover:text-white transition-colors"
            >Github</span
          >
          <svg
            class="w-6 h-6 text-gray-500 group-hover:text-white transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom Divider -->
    <div class="w-full h-px bg-white/10 mb-8"></div>

    <!-- Bottom Bar: Logo + Name -->
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-1.5 group">
        <img
          src={scaleXLogo.src}
          alt="ScaleX Logo"
          class="w-12 h-12 transition-transform duration-300 group-hover:scale-110"
        />
        <span class="text-2xl font-heading font-bold text-white leading-8"
          >ScaleX</span
        >
      </a>
      <div class="flex items-center gap-4">
        <!-- Social icons can go here -->
      </div>
    </div>
  </div>
</footer>
