---
// Footer component matching the reference design
import scaleXLogo from "../assets/images/ScaleX-Logo.png";
---

<footer class="py-10 lg:py-20" style="background-color: #050505;">
  <div class="px-8 lg:px-[120px]">
    <!-- Horizontal Rule -->
    <div class="w-full h-px bg-white/10 mb-10"></div>

    <!-- Top Section: Tagline + Links -->
    <div class="flex flex-col lg:flex-row items-center gap-6 mb-10">
      <!-- Left: Tagline -->
      <div class="flex-1">
        <p class="text-[32px] leading-[48px] font-['Schibsted_Grotesk'] font-medium tracking-[-2%] text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60">
          The capital efficient DeFi trading protocol bridging the gap between
          lending and derivatives.
        </p>
      </div>

      <!-- Vertical Separator -->
      <div class="hidden lg:block w-px self-stretch bg-white/10"></div>

      <!-- Right: Link Rows -->
      <div class="flex-1 flex flex-col gap-3 w-full">
        <a
          href="mailto:team@scalex.money"
          class="flex items-center justify-between group cursor-pointer"
        >
          <span
            class="text-[#CACACA] text-lg font-body font-normal leading-7 group-hover:text-white transition-colors"
            >Contact us</span
          >
          <svg
            class="w-6 h-6 text-gray-500 group-hover:text-white transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
        <div class="w-full h-px bg-white/10"></div>

        <a
          href="https://docs.scalex.money"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between group cursor-pointer"
        >
          <span
            class="text-[#CACACA] text-lg font-body font-normal leading-7 group-hover:text-white transition-colors"
            >Documentation</span
          >
          <svg
            class="w-6 h-6 text-gray-500 group-hover:text-white transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
        <div class="w-full h-px bg-white/10"></div>

        <a
          href="https://x.com/ScaleX_money"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between group cursor-pointer"
        >
          <span
            class="text-[#CACACA] text-lg font-body font-normal leading-7 group-hover:text-white transition-colors"
            >Twitter Community</span
          >
          <svg
            class="w-6 h-6 text-gray-500 group-hover:text-white transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
        <div class="w-full h-px bg-white/10"></div>

        <a
          href="https://github.com/ScaleX-Protocol"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between group cursor-pointer"
        >
          <span
            class="text-[#CACACA] text-lg font-body font-normal leading-7 group-hover:text-white transition-colors"
            >Github</span
          >
          <svg
            class="w-6 h-6 text-gray-500 group-hover:text-white transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom Divider -->
    <div class="w-full h-px bg-white/10 mb-8"></div>

    <!-- Bottom Bar: Logo + Name -->
    <div class="flex items-center justify-between">
      <span class="text-xs md:text-base font-medium font-['Schibsted_Grotesk'] tracking-[-2%] text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60 max-w-[136px]">
        © 2026 ScaleX Protocol. All rights reserved.
      </span>
      <a href="/" class="flex items-center gap-1.5 group z-10">
        <img src={scaleXLogo.src} alt="ScaleX Logo" class="w-8 h-8 md:w-12 md:h-12" />
        <span class="text-xl md:text-2xl font-heading font-bold text-white leading-8">ScaleX</span>
      </a>
      <div class="flex flex-row gap-4 justify-end items-center">
        <span class="text-xs md:text-base font-medium font-['Schibsted_Grotesk'] tracking-[-2%] text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60">Privacy Policy</span>
        <span class="text-xs md:text-base font-medium font-['Schibsted_Grotesk'] tracking-[-2%] text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60">Terms of Service</span>
      </div>
    </div>
  </div>
</footer>
