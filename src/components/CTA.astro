---
// Final CTA section - Modern Glossy Design
---

<section class="py-24 relative overflow-hidden">
  <!-- Background ambient glow -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-primary/10 rounded-full blur-[120px] animate-pulse"
    >
    </div>
  </div>

  <div class="section-container relative z-10">
    <div class="max-w-3xl mx-auto">
      <!-- Main Glossy Card -->
      <div class="cta-card group relative rounded-[2rem] overflow-hidden">
        <!-- Animated Gradient Blobs -->
        <div class="absolute inset-0 overflow-hidden">
          <div
            class="blob blob-1 absolute -top-20 -left-20 w-64 h-64 bg-primary/30 rounded-full blur-3xl"
          >
          </div>
          <div
            class="blob blob-2 absolute -bottom-20 -right-20 w-80 h-80 bg-primary/20 rounded-full blur-3xl"
          >
          </div>
          <div
            class="blob blob-3 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-primary/15 rounded-full blur-2xl"
          >
          </div>
        </div>

        <!-- Glassmorphism Background -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-white/[0.08] via-white/[0.02] to-transparent backdrop-blur-xl"
        >
        </div>

        <!-- Glossy Highlight Reflection -->
        <div
          class="absolute inset-0 bg-gradient-to-b from-white/10 via-transparent to-transparent h-1/2"
        >
        </div>
        <div
          class="shine absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full"
        >
        </div>

        <!-- Animated Border Glow -->
        <div class="absolute inset-0 rounded-[2rem]">
          <div class="absolute inset-0 rounded-[2rem] border border-white/10">
          </div>
          <div class="absolute inset-0 rounded-[2rem] border-glow"></div>
        </div>

        <!-- Inner glow on hover -->
        <div
          class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-br from-primary/10 via-transparent to-primary/5"
        >
        </div>

        <!-- Content -->
        <div class="relative p-12 md:p-16 lg:p-20 text-center space-y-8">
          <h2
            class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-white leading-tight"
          >
            Ready to <span class="gradient-text">Earn More</span>?
          </h2>

          <p
            class="text-lg md:text-xl text-gray-400 max-w-xl mx-auto leading-relaxed"
          >
            Join traders who refuse to let their capital sit idle. Start earning
            yield on every order today.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap justify-center gap-4 pt-4">
            <!-- Primary Button - Enhanced Glossy -->
            <a
              href="https://base-sepolia-app.scalex.money"
              class="primary-btn group/btn relative inline-flex items-center gap-3 px-8 py-4 text-lg font-heading font-semibold text-white rounded-full overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-glow-lg"
            >
              <!-- Button gradient background -->
              <div
                class="absolute inset-0 bg-gradient-to-r from-primary via-primary-dark to-primary"
              >
              </div>
              <!-- Button glossy overlay -->
              <div
                class="absolute inset-0 bg-gradient-to-b from-white/20 via-transparent to-transparent h-1/2"
              >
              </div>
              <!-- Button shine effect -->
              <div
                class="btn-shine absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full"
              >
              </div>

              <svg
                class="relative w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              <span class="relative">Launch App</span>
              <svg
                class="relative w-5 h-5 group-hover/btn:translate-x-1 transition-transform"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>

            <!-- Secondary Button - Glass Style -->
            <a
              href="https://docs.scalex.money"
              class="secondary-btn group/btn relative inline-flex items-center gap-3 px-8 py-4 text-lg font-heading font-semibold text-white rounded-full overflow-hidden border border-white/20 backdrop-blur-sm transition-all duration-300 hover:border-white/40 hover:bg-white/10"
            >
              <!-- Glass background -->
              <div class="absolute inset-0 bg-white/5"></div>
              <!-- Glass highlight -->
              <div
                class="absolute inset-0 bg-gradient-to-b from-white/10 via-transparent to-transparent h-1/2 opacity-50"
              >
              </div>

              <svg
                class="relative w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                ></path>
              </svg>
              <span class="relative">Documentation</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Blob animations */
  .blob {
    animation: blob-float 8s ease-in-out infinite;
  }

  .blob-1 {
    animation-delay: 0s;
  }

  .blob-2 {
    animation-delay: 2s;
    animation-duration: 10s;
  }

  .blob-3 {
    animation-delay: 4s;
    animation-duration: 12s;
  }

  @keyframes blob-float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(10px, -10px) scale(1.05);
    }
    50% {
      transform: translate(-5px, 5px) scale(0.95);
    }
    75% {
      transform: translate(-10px, -5px) scale(1.02);
    }
  }

  /* Shine animation on card hover */
  .cta-card:hover .shine {
    animation: shine 1.5s ease-in-out;
  }

  @keyframes shine {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  /* Button shine on hover */
  .primary-btn:hover .btn-shine {
    animation: shine 0.8s ease-in-out;
  }

  /* Animated border glow */
  .border-glow {
    background: conic-gradient(
      from 0deg,
      transparent,
      rgba(255, 102, 0, 0.3),
      transparent,
      rgba(255, 102, 0, 0.2),
      transparent
    );
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: xor;
    -webkit-mask-composite: xor;
    padding: 1px;
    animation: border-rotate 8s linear infinite;
  }

  @keyframes border-rotate {
    from {
      --rotation: 0deg;
    }
    to {
      --rotation: 360deg;
    }
  }

  /* Smoother hover transition for card */
  .cta-card {
    transition:
      transform 0.4s ease-out,
      box-shadow 0.4s ease-out;
  }

  .cta-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 0 60px -12px rgba(255, 102, 0, 0.4),
      0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
</style>
