---
// CTA Section - Banner with gradient background
---

<section
  class="py-10 relative overflow-hidden"
  style="background-color: #050505;"
>
  <div class="max-w-[1200px] mx-auto px-8 lg:px-[120px]">
    <!-- CTA Banner -->
    <div
      class="relative rounded-3xl overflow-hidden px-10 py-20 flex flex-col items-center gap-8"
      style="background: linear-gradient(135deg, rgba(240,103,24,0.15) 0%, rgba(12,12,12,1) 50%, rgba(240,103,24,0.08) 100%); border: 1px solid rgba(240,103,24,0.15);"
    >
      <!-- Wave pattern overlay -->
      <div
        class="absolute bottom-0 left-0 right-0 h-[276px] pointer-events-none opacity-10"
      >
        <svg
          class="w-full h-full"
          viewBox="0 0 1200 276"
          fill="none"
          preserveAspectRatio="none"
        >
          <path
            d="M0 138C100 184 300 276 600 138C900 0 1100 92 1200 138V276H0V138Z"
            fill="url(#cta-wave)"
            opacity="0.3"></path>
          <defs>
            <linearGradient id="cta-wave" x1="0" y1="0" x2="1200" y2="276">
              <stop offset="0%" stop-color="#F06718" stop-opacity="0.3"></stop>
              <stop offset="100%" stop-color="#F06718" stop-opacity="0.05"
              ></stop>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Radial glow -->
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] pointer-events-none"
        style="background: radial-gradient(ellipse at center, rgba(240,103,24,0.15) 0%, transparent 70%);"
      >
      </div>

      <!-- Heading -->
      <h2 class="text-[52px] leading-[62px] font-['Schibsted_Grotesk'] font-medium tracking-[-2%] mb-4 text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60">
        Ready to Earn More?
      </h2>

      <!-- Description -->
      <p
        class="relative z-10 text-lg text-[#CACACA] font-body font-normal leading-7 text-center tracking-[-1%]"
      >
        Join traders who refuse to let their capital sit idle. Start<br/>earning yield on every order today.
      </p>

      <!-- CTA Buttons -->
      <div class="relative z-10 flex items-center gap-4">
        <a
          href="https://base-sepolia-app.scalex.money"
          target="_blank"
          rel="noopener"
          class="btn-primary text-base group"
        >
          <svg
            class="w-6 h-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          Launch App
        </a>
        <a
          href="https://docs.scalex.money"
          target="_blank"
          rel="noopener"
          class="btn-secondary text-base group"
        >
          <svg
            class="w-6 h-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
          Read Docs
        </a>
      </div>
    </div>
  </div>
</section>
