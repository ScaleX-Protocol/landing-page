---
// Hero section - Full page with compelling stats
---

<section
  class="relative min-h-screen flex flex-col justify-center overflow-hidden"
>
  <!-- Background Glow Effects -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-1/4 right-1/4 w-[800px] h-[800px] bg-primary/8 rounded-full blur-[150px] opacity-60"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[120px] opacity-40"
    >
    </div>
  </div>

  <!-- Main Content -->
  <div class="section-container relative z-10 pt-24 pb-16">
    <div class="max-w-5xl mx-auto text-center space-y-8">
      <!-- Headline -->
      <div class="space-y-6">
        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-heading font-black leading-[1.1] tracking-[-0.03em]"
        >
          Your Limit Orders<br />
          <span class="gradient-text">Should Earn Yield.</span>
        </h1>

        <p
          class="text-lg sm:text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto leading-relaxed font-light"
        >
          The only DEX where idle capital works for you. Place limit orders,
          earn lending yield automatically. Zero extra steps.
        </p>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap justify-center gap-4 pt-4">
        <a
          href="https://base-sepolia-app.scalex.money"
          class="btn-primary text-lg px-8 py-4 group"
        >
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          Start Trading
          <svg
            class="w-5 h-5 group-hover:translate-x-1 transition-transform"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href="https://docs.scalex.money"
          class="btn-secondary text-lg px-8 py-4"
        >
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
          Read Docs
        </a>
      </div>

      <!-- Trust Indicators -->
      <!-- <div class="flex items-center justify-center gap-6 pt-2 opacity-60">
        <div class="flex items-center gap-2 text-gray-400">
          <svg
            class="w-5 h-5 text-primary"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span class="text-sm font-semibold">Audited by Certik</span>
        </div>
        <div class="w-px h-4 bg-gray-700"></div>
        <div class="flex items-center gap-2 text-gray-400">
          <svg
            class="w-5 h-5 text-primary"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span class="text-sm font-semibold">Trail of Bits</span>
        </div>
      </div> -->
    </div>

    <!-- Stats Section - Highlighted -->
    <div class="mt-20 max-w-4xl mx-auto">
      <div class="grid grid-cols-3 gap-4 md:gap-8">
        <!-- Total Volume -->
        <div
          class="group text-center p-6 md:p-8 rounded-2xl bg-surface-secondary/50 border border-border/50 hover:border-primary/30 hover:bg-surface-secondary transition-all duration-300 cursor-default"
        >
          <div class="flex items-center justify-center gap-2 mb-3">
            <svg
              class="w-5 h-5 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M18 20V10"></path>
              <path d="M12 20V4"></path>
              <path d="M6 20v-6"></path>
            </svg>
            <span
              class="text-sm text-gray-500 uppercase tracking-wider font-medium"
              >Volume</span
            >
          </div>
          <div
            class="text-3xl md:text-5xl font-heading font-black text-white mb-1"
          >
            $1.2B
          </div>
          <div
            class="text-sm font-bold text-primary flex items-center justify-center gap-1"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7,7 17,7 17,17"></polyline>
            </svg>
            +5.2% this week
          </div>
        </div>

        <!-- Current APY -->
        <div
          class="group text-center p-6 md:p-8 rounded-2xl bg-gradient-to-b from-primary/10 to-primary/5 border border-primary/30 hover:border-primary/50 transition-all duration-300 cursor-default ring-1 ring-primary/20 shadow-lg shadow-primary/10"
        >
          <div class="flex items-center justify-center gap-2 mb-3">
            <svg
              class="w-5 h-5 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="23,6 13.5,15.5 8.5,10.5 1,18"></polyline>
              <polyline points="17,6 23,6 23,12"></polyline>
            </svg>
            <span
              class="text-sm text-primary uppercase tracking-wider font-medium"
              >Avg. APY</span
            >
          </div>
          <div
            class="text-4xl md:text-6xl font-heading font-black text-primary mb-1"
          >
            12.5%
          </div>
          <div class="text-sm font-medium text-gray-400">
            on idle limit orders
          </div>
        </div>

        <!-- TVL -->
        <div
          class="group text-center p-6 md:p-8 rounded-2xl bg-surface-secondary/50 border border-border/50 hover:border-primary/30 hover:bg-surface-secondary transition-all duration-300 cursor-default"
        >
          <div class="flex items-center justify-center gap-2 mb-3">
            <svg
              class="w-5 h-5 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span
              class="text-sm text-gray-500 uppercase tracking-wider font-medium"
              >TVL</span
            >
          </div>
          <div
            class="text-3xl md:text-5xl font-heading font-black text-white mb-1"
          >
            $450M
          </div>
          <div
            class="text-sm font-bold text-primary flex items-center justify-center gap-1"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7,7 17,7 17,17"></polyline>
            </svg>
            +2.1% this week
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
