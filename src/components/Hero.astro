---
// Hero section matching the ScaleX reference design
---

<section
  class="relative min-h-screen flex flex-col overflow-hidden"
  style="background: linear-gradient(180deg, rgba(0, 0, 0, 1) 72%, rgba(25, 7, 3, 1) 100%); background-color: #050505;"
>
  <!-- Noise Texture Overlay -->
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none z-[2]"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;"
  >
  </div>

  <!-- Background Glow Effect - Top Center -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[220px] pointer-events-none z-[1]"
  >
    <div
      class="w-full h-full"
      style="background: radial-gradient(ellipse at center, rgba(240,103,24,0.2) 0%, rgba(240,103,24,0.05) 40%, transparent 70%);"
    >
    </div>
  </div>

  <!-- Bottom Gradient Fade -->
  <div
    class="absolute bottom-0 left-0 right-0 h-[195px] pointer-events-none z-[2]"
    style="background: linear-gradient(to top, rgba(25, 7, 3, 1) 0%, transparent 100%);"
  >
  </div>

  <!-- 3D Coin Assets -->
  <div
    class="absolute top-[154px] left-[38px] right-[37px] h-[349px] z-[3] pointer-events-none hidden lg:block"
  >
    <div class="relative w-full h-full flex items-center justify-center">
      <!-- Coin arc representation using CSS -->
      <div
        class="flex items-end justify-center gap-4"
        style="transform: perspective(800px) rotateX(5deg);"
      >
        <!-- USDT -->
        <div
          class="coin-item w-[120px] h-[120px] rounded-full bg-gradient-to-br from-[#26A17B]/80 to-[#26A17B]/40 border border-[#26A17B]/30 flex items-center justify-center shadow-[0_8px_32px_rgba(38,161,123,0.3)] animate-float"
          style="animation-delay: 0s; transform: translateY(20px);"
        >
          <span class="text-white font-heading font-bold text-lg">USDT</span>
        </div>
        <!-- ETH -->
        <div
          class="coin-item w-[140px] h-[140px] rounded-full bg-gradient-to-br from-[#627EEA]/80 to-[#627EEA]/40 border border-[#627EEA]/30 flex items-center justify-center shadow-[0_8px_32px_rgba(98,126,234,0.3)] animate-float"
          style="animation-delay: 0.2s; transform: translateY(-10px);"
        >
          <span class="text-white font-heading font-bold text-xl">ETH</span>
        </div>
        <!-- BTC -->
        <div
          class="coin-item w-[160px] h-[160px] rounded-full bg-gradient-to-br from-[#F7931A]/80 to-[#F7931A]/40 border border-[#F7931A]/30 flex items-center justify-center shadow-[0_8px_32px_rgba(247,147,26,0.4)] animate-float"
          style="animation-delay: 0.4s; transform: translateY(-30px);"
        >
          <span class="text-white font-heading font-bold text-2xl">BTC</span>
        </div>
        <!-- USDC -->
        <div
          class="coin-item w-[140px] h-[140px] rounded-full bg-gradient-to-br from-[#2775CA]/80 to-[#2775CA]/40 border border-[#2775CA]/30 flex items-center justify-center shadow-[0_8px_32px_rgba(39,117,202,0.3)] animate-float"
          style="animation-delay: 0.6s; transform: translateY(-10px);"
        >
          <span class="text-white font-heading font-bold text-xl">USDC</span>
        </div>
        <!-- IDRX -->
        <div
          class="coin-item w-[120px] h-[120px] rounded-full bg-gradient-to-br from-[#E74C3C]/80 to-[#E74C3C]/40 border border-[#E74C3C]/30 flex items-center justify-center shadow-[0_8px_32px_rgba(231,76,60,0.3)] animate-float"
          style="animation-delay: 0.8s; transform: translateY(20px);"
        >
          <span class="text-white font-heading font-bold text-lg">IDRX</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave Pattern (decorative bottom) -->
  <div
    class="absolute bottom-0 left-0 right-0 h-[331px] pointer-events-none z-[1] opacity-20"
  >
    <svg
      class="w-full h-full"
      viewBox="0 0 1440 331"
      fill="none"
      preserveAspectRatio="none"
    >
      <path
        d="M0 165.5C120 220 360 331 720 165.5C1080 0 1320 110 1440 165.5V331H0V165.5Z"
        fill="url(#wave-gradient)"
        opacity="0.1"></path>
      <defs>
        <linearGradient id="wave-gradient" x1="0" y1="0" x2="1440" y2="331">
          <stop offset="0%" stop-color="#F06718" stop-opacity="0.2"></stop>
          <stop offset="100%" stop-color="#F06718" stop-opacity="0.05"></stop>
        </linearGradient>
      </defs>
    </svg>
  </div>

  <!-- Main Content -->
  <div
    class="relative z-10 flex-1 flex items-end px-8 lg:px-[100px] pb-16 pt-[450px] lg:pt-[520px]"
  >
    <div
      class="flex flex-col lg:flex-row items-end justify-between w-full max-w-[1240px] mx-auto gap-12"
    >
      <!-- Left: Badge + CTA -->
      <div class="flex flex-col gap-6 items-start">
        <!-- Badge -->
        <div
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-white/10"
          style="background-color: rgba(255, 255, 255, 0.04);"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span
              class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 green-pulse"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500 border border-green-400/20"
            ></span>
          </span>
          <span class="text-white text-base font-body font-medium leading-4"
            >Live on Base Sepolia</span
          >
        </div>

        <!-- Headline -->
        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-[80px] font-heading font-black leading-[0.95] tracking-tight text-white"
        >
          We Pay You<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-orange-400 to-yellow-400"
            >To Trade Here.</span
          >
        </h1>

        <!-- CTA Buttons -->
        <div class="flex items-center gap-4">
          <a
            href="https://base-sepolia-app.scalex.money"
            target="_blank"
            rel="noopener"
            class="btn-primary text-base group"
          >
            <svg
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Start Trading
          </a>
          <a
            href="https://docs.scalex.money"
            target="_blank"
            rel="noopener"
            class="btn-secondary text-base group"
          >
            <svg
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
            Read Docs
          </a>
        </div>
      </div>

      <!-- Right: Description + Stats -->
      <div class="flex flex-col gap-8 w-full lg:w-[560px]">
        <p class="text-[#CACACA] text-xl font-body font-normal leading-8">
          The only DEX where limit orders generate yield automatically. Trade
          smarter. Earn passively. Zero extra steps.
        </p>

        <!-- Stats with Vertical Separators -->
        <div class="flex items-start gap-6">
          <!-- Stat 1 -->
          <div class="flex flex-col gap-1 w-[144px]">
            <span class="text-white text-[28px] font-body font-medium leading-9"
              >$1.2B</span
            >
            <span
              class="text-[#CACACA] text-lg font-body font-normal leading-[30px]"
              >Total Volume</span
            >
          </div>

          <!-- Separator -->
          <div class="self-stretch w-px flex items-center">
            <svg
              width="1"
              height="100%"
              viewBox="0 0 1 70"
              preserveAspectRatio="none"
              class="h-full"
            >
              <line
                x1="0.5"
                y1="0"
                x2="0.5"
                y2="70"
                stroke="rgba(255,255,255,0.2)"
                stroke-width="1"></line>
            </svg>
          </div>

          <!-- Stat 2 -->
          <div class="flex flex-col gap-1 w-[144px]">
            <span class="text-white text-[28px] font-body font-medium leading-9"
              >12.5%</span
            >
            <span
              class="text-[#CACACA] text-lg font-body font-normal leading-[30px]"
              >Limit Order APY</span
            >
          </div>

          <!-- Separator -->
          <div class="self-stretch w-px flex items-center">
            <svg
              width="1"
              height="100%"
              viewBox="0 0 1 70"
              preserveAspectRatio="none"
              class="h-full"
            >
              <line
                x1="0.5"
                y1="0"
                x2="0.5"
                y2="70"
                stroke="rgba(255,255,255,0.2)"
                stroke-width="1"></line>
            </svg>
          </div>

          <!-- Stat 3 -->
          <div class="flex flex-col gap-1 w-[144px]">
            <span class="text-white text-[28px] font-body font-medium leading-9"
              >$450M</span
            >
            <span
              class="text-[#CACACA] text-lg font-body font-normal leading-[30px]"
              >TVL</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .coin-item {
    transition: transform 0.3s ease;
  }
  .coin-item:hover {
    transform: translateY(-10px) scale(1.05) !important;
  }
</style>
