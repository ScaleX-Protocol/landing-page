---
// Flywheel/Compounding Engine - Radial Quad Layout with center logo
import scaleXLogo from "../assets/images/ScaleX.webp";

const steps = [
  {
    number: "01",
    title: "Deposit",
    description:
      "Your assets immediately start earning yield in lending pools.",
    position: "top-left",
    isOrange: true,
  },
  {
    number: "02",
    title: "Trade",
    description: "Use yield-bearing tokens as margin for leveraged positions.",
    position: "top-right",
    isOrange: false,
  },
  {
    number: "03",
    title: "Earn",
    description: "Yield auto-compounds. Loans auto-repay. Collateral grows.",
    position: "bottom-right",
    isOrange: false,
  },
  {
    number: "04",
    title: "Repeat",
    description: "More collateral = more borrowing power. The cycle compounds.",
    position: "bottom-left",
    isOrange: false,
  },
];
---

<section
  class="py-20 lg:py-[80px] relative overflow-hidden"
  id="flywheel"
  style="background-color: #050505;"
>
  <div class="max-w-[1200px] mx-auto px-8 lg:px-[120px]">
    <!-- Section Header -->
    <div class="text-center mb-[52px] max-w-[600px] mx-auto">
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-4 text-white"
      >
        The Compounding Engine
      </h2>
      <p class="text-lg text-[#CACACA] font-body font-normal leading-7">
        A self-reinforcing cycle that grows your portfolio while you trade.
      </p>
    </div>

    <!-- Radial Layout Container -->
    <div
      class="relative w-full"
      style="height: 800px; max-width: 1200px; margin: 0 auto;"
    >
      <!-- Radial overlay glow behind center -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[523px] h-[523px] pointer-events-none"
        style="background: radial-gradient(ellipse at center, rgba(240,103,24,0.12) 0%, transparent 70%);"
      >
      </div>

      <!-- Decorative grid pattern -->
      <div class="absolute inset-0 pointer-events-none opacity-5">
        <svg class="w-full h-full" viewBox="0 0 815 798" fill="none">
          <line
            x1="0"
            y1="200"
            x2="815"
            y2="200"
            stroke="white"
            stroke-width="0.5"></line>
          <line
            x1="0"
            y1="400"
            x2="815"
            y2="400"
            stroke="white"
            stroke-width="0.5"></line>
          <line
            x1="0"
            y1="600"
            x2="815"
            y2="600"
            stroke="white"
            stroke-width="0.5"></line>
          <line
            x1="200"
            y1="0"
            x2="200"
            y2="798"
            stroke="white"
            stroke-width="0.5"></line>
          <line
            x1="400"
            y1="0"
            x2="400"
            y2="798"
            stroke="white"
            stroke-width="0.5"></line>
          <line
            x1="600"
            y1="0"
            x2="600"
            y2="798"
            stroke="white"
            stroke-width="0.5"></line>
        </svg>
      </div>

      <!-- Concentric Circles -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none"
      >
        <!-- Outer circle -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full border border-white/5"
        >
        </div>
        <!-- Middle circle -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[380px] h-[380px] rounded-full border border-white/8"
        >
        </div>
        <!-- Inner circle -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[260px] h-[260px] rounded-full border border-white/10"
        >
        </div>
      </div>

      <!-- Center Engine Logo -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20"
      >
        <div
          class="flex items-center justify-center p-8 rounded-full"
          style="background-color: rgba(255,255,255,0.12);"
        >
          <div
            class="w-[160px] h-[160px] rounded-full flex items-center justify-center engine-pulse"
            style="background-color: #F06718; border: 2px solid rgba(240,103,24,0.8); box-shadow: 0px 0px 0px 1.5px #F06718;"
          >
            <svg
              class="w-[62px] h-[100px] text-white"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M13 10V3L4 14h7v7l9-11h-7z" fill="white" stroke="none"
              ></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Step Cards -->
      <!-- 01: Top-Left -->
      <div
        class="absolute top-[80px] left-[0px] lg:left-[100px] w-[300px] lg:w-[350px] flywheel-step"
        data-step-index="0"
      >
        <div
          class="glass-card glass-card-orange glow-top-orange flex flex-col gap-6 p-8 rounded-[20px]"
        >
          <div class="flex flex-col gap-6">
            <div
              class="w-11 h-11 rounded-[10px] flex items-center justify-center"
              style="background: linear-gradient(0deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.16) 46%); background-color: #F06718; box-shadow: 0px 3.38px 13.54px -1.69px rgba(41,43,50,0.5); border: 0.85px solid rgba(255,255,255,0.1);"
            >
              <span
                class="text-white text-xl font-body font-extrabold leading-6"
                >01</span
              >
            </div>
            <div class="flex flex-col gap-2">
              <span
                class="text-white text-xl font-heading font-medium leading-6"
                >Deposit</span
              >
              <span
                class="text-white/80 text-base font-body font-normal leading-6"
                >Your assets immediately start earning yield in lending pools.</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- 02: Top-Right -->
      <div
        class="absolute top-[80px] right-[0px] lg:right-[100px] w-[300px] lg:w-[350px] flywheel-step"
        data-step-index="1"
      >
        <div
          class="glass-card glow-top-gray flex flex-col gap-6 p-8 rounded-[20px]"
        >
          <div class="flex flex-col gap-6">
            <div
              class="w-11 h-11 rounded-[10px] flex items-center justify-center"
              style="background: linear-gradient(0deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.16) 46%); background-color: #2C2C2C; box-shadow: 0px 3.38px 13.54px -1.69px rgba(41,43,50,0.5); border: 0.85px solid rgba(255,255,255,0.1);"
            >
              <span
                class="text-white text-xl font-body font-extrabold leading-6"
                >02</span
              >
            </div>
            <div class="flex flex-col gap-2">
              <span
                class="text-white text-xl font-heading font-medium leading-6"
                >Trade</span
              >
              <span
                class="text-white/60 text-base font-body font-normal leading-6"
                >Use yield-bearing tokens as margin for leveraged positions.</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- 03: Bottom-Right -->
      <div
        class="absolute bottom-[80px] right-[0px] lg:right-[100px] w-[300px] lg:w-[350px] flywheel-step"
        data-step-index="2"
      >
        <div
          class="glass-card glow-top-gray flex flex-col gap-6 p-8 rounded-[20px]"
        >
          <div class="flex flex-col gap-6">
            <div
              class="w-11 h-11 rounded-[10px] flex items-center justify-center"
              style="background: linear-gradient(0deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.16) 46%); background-color: #2C2C2C; box-shadow: 0px 3.38px 13.54px -1.69px rgba(41,43,50,0.5); border: 0.85px solid rgba(255,255,255,0.1);"
            >
              <span
                class="text-white text-xl font-body font-extrabold leading-6"
                >03</span
              >
            </div>
            <div class="flex flex-col gap-2">
              <span
                class="text-white text-xl font-heading font-medium leading-6"
                >Earn</span
              >
              <span
                class="text-white/60 text-base font-body font-normal leading-6"
                >Yield auto-compounds. Loans auto-repay. Collateral grows.</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- 04: Bottom-Left -->
      <div
        class="absolute bottom-[80px] left-[0px] lg:left-[100px] w-[300px] lg:w-[350px] flywheel-step"
        data-step-index="3"
      >
        <div
          class="glass-card glow-top-gray flex flex-col gap-6 p-8 rounded-[20px]"
        >
          <div class="flex flex-col gap-6">
            <div
              class="w-11 h-11 rounded-[10px] flex items-center justify-center"
              style="background: linear-gradient(0deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.16) 46%); background-color: #2C2C2C; box-shadow: 0px 3.38px 13.54px -1.69px rgba(41,43,50,0.5); border: 0.85px solid rgba(255,255,255,0.1);"
            >
              <span
                class="text-white text-xl font-body font-extrabold leading-6"
                >04</span
              >
            </div>
            <div class="flex flex-col gap-2">
              <span
                class="text-white text-xl font-heading font-medium leading-6"
                >Repeat</span
              >
              <span
                class="text-white/60 text-base font-body font-normal leading-6"
                >More collateral = more borrowing power. The cycle compounds.</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Engine pulse glow */
  .engine-pulse {
    animation: engineGlow 3s ease-in-out infinite;
  }

  @keyframes engineGlow {
    0%,
    100% {
      box-shadow:
        0 0 30px rgba(240, 103, 24, 0.2),
        0 0 60px rgba(240, 103, 24, 0.1);
    }
    50% {
      box-shadow:
        0 0 50px rgba(240, 103, 24, 0.4),
        0 0 100px rgba(240, 103, 24, 0.2);
    }
  }

  /* Flywheel step entrance animation */
  .flywheel-step {
    opacity: 0;
    transform: translateY(20px);
    animation: stepFadeIn 0.6s ease-out forwards;
  }

  .flywheel-step:nth-child(1) {
    animation-delay: 0s;
  }
  .flywheel-step:nth-child(2) {
    animation-delay: 0.15s;
  }
  .flywheel-step:nth-child(3) {
    animation-delay: 0.3s;
  }
  .flywheel-step:nth-child(4) {
    animation-delay: 0.45s;
  }

  @keyframes stepFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Active step state */
  .flywheel-step.step-active .glass-card {
    border-color: rgba(240, 103, 24, 0.5) !important;
    box-shadow: 0 10px 40px -10px rgba(240, 103, 24, 0.3);
    transform: translateY(-4px);
  }
</style>

<script>
  // Flywheel auto-cycling
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          startAutoCycle();
        } else {
          stopAutoCycle();
        }
      });
    },
    { threshold: 0.2 },
  );

  const flywheelSection = document.getElementById("flywheel");
  if (flywheelSection) {
    observer.observe(flywheelSection);
  }

  let currentStep = 0;
  let cycleInterval: ReturnType<typeof setInterval> | null = null;
  const totalSteps = 4;
  const stepDuration = 2500;

  function activateStep(index: number) {
    const steps = document.querySelectorAll(".flywheel-step");
    steps.forEach((step) => step.classList.remove("step-active"));
    const currentStepEl = document.querySelector(
      `[data-step-index="${index}"]`,
    );
    if (currentStepEl) {
      currentStepEl.classList.add("step-active");
    }
  }

  function startAutoCycle() {
    if (cycleInterval) return;
    activateStep(currentStep);
    cycleInterval = setInterval(() => {
      currentStep = (currentStep + 1) % totalSteps;
      activateStep(currentStep);
    }, stepDuration);
  }

  function stopAutoCycle() {
    if (cycleInterval) {
      clearInterval(cycleInterval);
      cycleInterval = null;
    }
  }
</script>
