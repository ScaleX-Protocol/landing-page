---
// Flywheel.astro

const steps = [
  {
    number: "01",
    title: "Deposit",
    description: "Your assets immediately start earning yield in lending pools.",
    // Posisi Desktop: Kiri Atas
    position: "md:top-0 md:left-0 md:-translate-x-12", 
  },
  {
    number: "02",
    title: "Trade",
    description: "Use yield-bearing tokens as margin for leveraged positions.",
    // Posisi Desktop: Kanan Atas
    position: "md:top-0 md:right-0 md:translate-x-12",
  },
  {
    number: "03",
    title: "Earn",
    description: "Yield auto-compounds. Loans auto-repay. Collateral grows.",
    // Posisi Desktop: Kanan Bawah
    position: "md:bottom-0 md:right-0 md:translate-x-12",
  },
  {
    number: "04",
    title: "Repeat",
    description: "More collateral = more borrowing power. The cycle compounds.",
    // Posisi Desktop: Kiri Bawah
    position: "md:bottom-0 md:left-0 md:-translate-x-12",
  },
];
---

<section class="py-32 relative overflow-hidden" id="flywheel">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute inset-0 bg-gradient-to-b from-surface-primary via-surface-secondary/20 to-surface-primary"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/10 rounded-full blur-[120px]"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4">
    <div class="text-center mb-20 max-w-3xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-display font-semibold mb-6 section-gradient-text text-white">
        The Compounding Engine
      </h2>
      <p class="text-lg font-body text-secondary text-white/60">
        A self-reinforcing cycle that grows your portfolio while you trade.
      </p>
    </div>

    <div id="flywheel-container" class="relative mx-auto max-w-[900px] md:h-[650px]">

      <div class="flex justify-center mb-12 md:mb-0 md:absolute md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2">
        <div class="relative w-[200px] h-[200px] flex items-center justify-center">
          
          <svg class="absolute w-0 h-0">
            <defs>
              <linearGradient id="orbit-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#F97316" stop-opacity="0.6"></stop>
                <stop offset="50%" stop-color="#F97316" stop-opacity="0.1"></stop>
                <stop offset="100%" stop-color="#F97316" stop-opacity="0.6"></stop>
              </linearGradient>
            </defs>
          </svg>

          <div class="absolute inset-0 -m-[200px] animate-spin-veryslow-reverse opacity-30">
            <svg class="w-full h-full" viewBox="0 0 600 600">
              <circle cx="300" cy="300" r="280" fill="none" stroke="#F97316" stroke-width="1" stroke-dasharray="4 8" stroke-opacity="0.3"></circle>
            </svg>
          </div>

          <div class="absolute inset-0 -m-[120px] animate-spin-slower opacity-50">
            <svg class="w-full h-full" viewBox="0 0 440 440">
              <circle cx="220" cy="220" r="210" fill="none" stroke="#F97316" stroke-width="1" stroke-dasharray="6 6" stroke-opacity="0.4"></circle>
            </svg>
          </div>

          <div class="absolute inset-0 -m-10 animate-spin-reverse">
            <svg class="w-full h-full" viewBox="0 0 280 280">
              <circle cx="140" cy="140" r="135" fill="none" stroke="url(#orbit-gradient)" stroke-width="2" stroke-dasharray="10 10"></circle>
            </svg>
          </div>

          <div class="absolute inset-0 m-2 animate-spin-slow">
            <svg class="w-full h-full" viewBox="0 0 180 180">
              <circle cx="90" cy="90" r="88" fill="none" stroke="rgba(249,115,22,0.3)" stroke-width="1" stroke-dasharray="4 4"></circle>
            </svg>
          </div>

          <div class="relative w-24 h-24 rounded-full bg-gradient-to-b from-orange-500 to-orange-700 flex items-center justify-center shadow-[0_0_50px_rgba(249,115,22,0.5)] z-10">
            <svg class="w-10 h-10 text-white fill-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            
            <div class="absolute inset-0 rounded-full border border-orange-500/30 animate-ping" style="animation-duration: 2s;"></div>
            <div class="absolute inset-0 -m-2 rounded-full border border-orange-500/20 animate-ping" style="animation-duration: 3s;"></div>
          </div>

        </div>
      </div>

      <div class="grid grid-cols-1 md:block gap-4">
        {steps.map((step, i) => (
          <div
            class:list={[
              'flywheel-step group relative w-full md:absolute p-8 rounded-2xl border backdrop-blur-sm cursor-pointer transition-all duration-500 ease-out',
              // Ukuran Persegi Panjang
              'md:w-80', 
              step.position,
              // UPDATED: Default Inactive State (Gray/Neutral style)
              'bg-gradient-to-br from-neutral-800/80 to-neutral-900/80 border-neutral-700/50 hover:border-neutral-600'
            ]}
            style={`animation-delay: ${i * 0.15}s;`}
            data-step-index={i}
          >
            <div class="step-badge mb-4 inline-flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold transition-colors duration-300 bg-neutral-700 text-neutral-300 border border-neutral-600">
              {step.number}
            </div>

            <h3 class="step-title mb-2 text-xl font-bold transition-colors duration-300 text-neutral-200">
              {step.title}
            </h3>

            <p class="step-desc text-sm leading-relaxed transition-colors duration-300 text-neutral-400">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* --- Section Gradient Text --- */
  .section-gradient-text {
    background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0.6) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* --- Active State Styling (Tetap Orange/Amber) --- */
  .flywheel-step.step-active {
    /* Background active tetap orange warm agar kontras dengan gray */
    background-image: linear-gradient(to bottom right, rgba(120, 53, 15, 0.9), rgba(69, 26, 3, 0.9)); /* Amber-900 */
    border-color: rgba(249, 115, 22, 0.5); /* Orange-500 */
    box-shadow: 0 0 30px -5px rgba(249, 115, 22, 0.3);
    transform: translateY(-8px);
    z-index: 20;
  }
  .flywheel-step.step-active .step-badge {
    background-color: rgb(249, 115, 22);
    color: white;
    border-color: transparent;
  }
  .flywheel-step.step-active .step-title {
    color: white;
  }
  .flywheel-step.step-active .step-desc {
    color: rgba(255, 237, 213, 0.8);
  }

  /* --- Custom Animations --- */
  .animate-spin-slow { animation: spin 20s linear infinite; }
  .animate-spin-slower { animation: spin 40s linear infinite; }
  
  .animate-spin-reverse { animation: spin 30s linear infinite reverse; }
  .animate-spin-veryslow-reverse { animation: spin 60s linear infinite reverse; }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  // Setup Observer
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const steps = entry.target.querySelectorAll('.flywheel-step');
          steps.forEach((step, index) => {
            // Casting ke HTMLElement agar method .animate dikenali dengan baik
            const el = step as HTMLElement;
            el.animate([
              { opacity: '0', transform: 'translateY(20px)' },
              { opacity: '1', transform: 'translateY(0)' }
            ], {
              duration: 600,
              delay: index * 150,
              fill: 'forwards',
              easing: 'ease-out'
            });
          });
          startAutoCycle();
        } else {
          stopAutoCycle();
        }
      });
    },
    { threshold: 0.2 },
  );

  const flywheelSection = document.getElementById('flywheel');
  if (flywheelSection) observer.observe(flywheelSection);

  // Logic Rotasi
  let currentStep = 0;
  
  // FIX 1: Tipe eksplisit untuk interval timer
  let cycleInterval: ReturnType<typeof setInterval> | null = null;
  
  const totalSteps = 4;
  const stepDuration = 2500;

  // FIX 2: Tipe eksplisit 'index: number'
  function activateStep(index: number) {
    document.querySelectorAll('.flywheel-step').forEach((s) => {
      s.classList.remove('step-active');
    });
    const el = document.querySelector(`[data-step-index="${index}"]`);
    if (el) el.classList.add('step-active');
  }

  function startAutoCycle() {
    if (cycleInterval) return;
    activateStep(currentStep);
    cycleInterval = setInterval(() => {
      currentStep = (currentStep + 1) % totalSteps;
      activateStep(currentStep);
    }, stepDuration);
  }

  function stopAutoCycle() {
    if (cycleInterval) {
      clearInterval(cycleInterval);
      cycleInterval = null;
    }
  }

  const container = document.getElementById('flywheel-container');
  if (container) {
    container.addEventListener('mouseenter', () => {
      stopAutoCycle();
    });
    container.addEventListener('mouseleave', () => {
      startAutoCycle();
    });

    const steps = document.querySelectorAll('.flywheel-step');
    steps.forEach((step, idx) => {
      step.addEventListener('click', () => {
        currentStep = idx;
        activateStep(currentStep);
      });
    });
  }
</script>