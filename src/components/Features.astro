---
// Features section - Bento Grid with background icons
---

<section class="py-24 relative overflow-hidden" id="features">
  <!-- Background -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px]"
    >
    </div>
  </div>

  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6">
        Built for Serious Traders
      </h2>
      <p class="text-lg text-gray-400">
        Every feature designed to maximize your capital efficiency and trading
        edge.
      </p>
    </div>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-6xl mx-auto">
      <!-- Large Card - Yield on Active Orders (spans 2 rows on left) -->
      <div
        class="group relative lg:col-span-5 lg:row-span-2 flex flex-col overflow-hidden rounded-3xl bg-surface-secondary border border-border/50 p-8 transition-all duration-500 hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1"
      >
        <!-- Background Icon -->
        <div
          class="absolute -right-8 -bottom-8 opacity-5 group-hover:opacity-10 transition-opacity pointer-events-none"
        >
          <svg
            class="w-48 h-48 text-primary"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
          >
            <polyline points="23,6 13.5,15.5 8.5,10.5 1,18"></polyline>
            <polyline points="17,6 23,6 23,12"></polyline>
          </svg>
        </div>

        <!-- Hover Gradient -->
        <div
          class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>

        <div class="relative z-10 flex flex-col h-full">
          <!-- Icon -->
          <div
            class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-all duration-500 group-hover:bg-primary group-hover:text-white group-hover:scale-110"
          >
            <svg
              class="w-7 h-7"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="23,6 13.5,15.5 8.5,10.5 1,18"></polyline>
              <polyline points="17,6 23,6 23,12"></polyline>
            </svg>
          </div>

          <!-- Content -->
          <h3
            class="mb-3 text-2xl font-heading font-bold text-white group-hover:text-primary transition-colors"
          >
            Passive Yield on Every Order
          </h3>
          <p class="text-gray-400 leading-relaxed mb-6">
            Your limit orders automatically earn lending yield while waiting to
            fill. No extra steps, no configuration—just place your order and
            start earning.
          </p>

          <!-- Stats Visual -->
          <div class="mt-auto pt-6 border-t border-border/30">
            <div class="flex items-end gap-2">
              <span class="text-4xl font-heading font-black text-primary"
                >12.5%</span
              >
              <span class="text-lg text-gray-500 mb-1">avg APY</span>
            </div>
            <p class="text-sm text-gray-500 mt-1">on idle limit orders</p>
          </div>
        </div>
      </div>

      <!-- Card - Soft Liquidations (top right) -->
      <div
        class="group relative lg:col-span-7 flex flex-col md:flex-row items-start gap-6 overflow-hidden rounded-3xl bg-surface-secondary border border-border/50 p-8 transition-all duration-500 hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1"
      >
        <!-- Background Icon -->
        <div
          class="absolute -right-6 -bottom-6 opacity-5 group-hover:opacity-10 transition-opacity pointer-events-none"
        >
          <svg
            class="w-32 h-32 text-primary"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>

        <div class="relative shrink-0">
          <!-- Icon -->
          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-all duration-500 group-hover:bg-primary group-hover:text-white group-hover:scale-110"
          >
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
        </div>

        <div class="relative z-10 flex-1">
          <h3
            class="mb-2 text-xl font-heading font-bold text-white group-hover:text-primary transition-colors"
          >
            Soft Liquidations
          </h3>
          <p class="text-gray-400 leading-relaxed">
            Our engine protects your positions with gradual liquidations. No
            sudden wipeouts—positions are unwound smoothly at the exact trigger
            price.
          </p>
        </div>
      </div>

      <!-- Card - Auto-Repay Loans (bottom right) -->
      <div
        class="group relative lg:col-span-7 flex flex-col md:flex-row-reverse items-start gap-6 overflow-hidden rounded-3xl bg-surface-secondary border border-border/50 p-8 transition-all duration-500 hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1"
      >
        <!-- Background Icon -->
        <div
          class="absolute -left-6 -bottom-6 opacity-5 group-hover:opacity-10 transition-opacity pointer-events-none"
        >
          <svg
            class="w-32 h-32 text-primary"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
            <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
            <path d="M18 12a2 2 0 0 0 0 4h4v-4h-4z"></path>
          </svg>
        </div>

        <div class="relative shrink-0">
          <!-- Icon -->
          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-all duration-500 group-hover:bg-primary group-hover:text-white group-hover:scale-110"
          >
            <svg
              class="w-7 h-7"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
              <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
              <path d="M18 12a2 2 0 0 0 0 4h4v-4h-4z"></path>
            </svg>
          </div>
        </div>

        <div class="relative z-10 flex-1 text-left md:text-right">
          <h3
            class="mb-2 text-xl font-heading font-bold text-white group-hover:text-primary transition-colors"
          >
            Auto-Repay Loans
          </h3>
          <p class="text-gray-400 leading-relaxed">
            Yield generated automatically pays down your loans. Your debt
            shrinks while you sleep—no manual repayments needed.
          </p>
        </div>
      </div>

      <!-- Card - 10x Leverage (bottom full width)
