---
// Features section - 2x2 Bordered Cell Layout matching reference
const features = [
  {
    title: "Passive Yield on Every Order",
    description:
      "Your limit orders automatically earn lending yield while\nwaiting to fill. No extra steps needed.",
    stat: "12.5%",
    statLabel: "Avg APY",
  },
  {
    title: "Borrow from Your Portfolio",
    description:
      "No need to move assets around. Borrow instantly against\nyour portfolio in one click.",
    stat: "1-Click",
    statLabel: "Instant Borrow",
  },
  {
    title: "Soft Liquidations",
    description:
      "Positions are unwound gradually at the exact trigger price.\nNo sudden wipeouts.",
    stat: "Gradual",
    statLabel: "Protection",
  },
  {
    title: "Auto-Repay Loans",
    description:
      "Yield generated automatically pays down your loans. Your\ndebt shrinks while you sleep.",
    stat: "Auto",
    statLabel: "Repayment",
  },
];
---

<section
  class="relative overflow-hidden py-20"
  id="features"
  style="background-color: #050505; border-top: 1px solid rgba(255,255,255,0.12);"
>
  <!-- Decorative Pattern (optional background SVG) -->
  <div
    class="absolute -top-[315px] left-1/2 -translate-x-1/2 w-[619px] h-[606px] pointer-events-none z-[2] opacity-10"
  >
    <svg class="w-full h-full" viewBox="0 0 619 606" fill="none">
      <circle
        cx="309.5"
        cy="303"
        r="300"
        stroke="rgba(240,103,24,0.15)"
        stroke-width="0.5"
        fill="none"></circle>
      <circle
        cx="309.5"
        cy="303"
        r="200"
        stroke="rgba(240,103,24,0.1)"
        stroke-width="0.5"
        fill="none"></circle>
      <circle
        cx="309.5"
        cy="303"
        r="100"
        stroke="rgba(240,103,24,0.08)"
        stroke-width="0.5"
        fill="none"></circle>
    </svg>
  </div>

  <div class="max-w-[1200px] mx-auto px-8 lg:px-0 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-[52px] max-w-[600px] mx-auto">
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-4 text-white"
      >
        Built for Serious Traders
      </h2>
      <p class="text-lg text-[#CACACA] font-body font-normal leading-7">
        Every feature designed to maximize your capital efficiency and trading
        edge. Same trades.
        <span class="text-white">Same strategy. More profit.</span>
      </p>
    </div>

    <!-- 2x2 Bordered Grid -->
    <div class="relative z-[1]">
      <!-- Top Row -->
      <div
        class="flex flex-col md:flex-row"
        style="border-top: 1px solid rgba(255,255,255,0.12); border-bottom: 1px solid rgba(255,255,255,0.12);"
      >
        {
          features.slice(0, 2).map((feature, index) => (
            <div
              class={`flex-1 p-10 flex flex-col gap-10 justify-center ${index === 0 ? "border-r border-white/[0.12]" : ""}`}
            >
              <div class="flex flex-col gap-2">
                <h3 class="text-white text-2xl font-heading font-medium leading-9">
                  {feature.title}
                </h3>
                <p class="text-white/60 text-lg font-body font-normal leading-7 whitespace-pre-line">
                  {feature.description}
                </p>
              </div>
              <div class="flex flex-col gap-2">
                <span class="text-primary text-[44px] font-heading font-medium leading-[54px]">
                  {feature.stat}
                </span>
                <span class="text-white/60 text-lg font-body font-normal leading-[26px]">
                  {feature.statLabel}
                </span>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Bottom Row -->
      <div
        class="flex flex-col md:flex-row"
        style="border-bottom: 1px solid rgba(255,255,255,0.12);"
      >
        {
          features.slice(2, 4).map((feature, index) => (
            <div
              class={`flex-1 p-10 flex flex-col gap-10 justify-center ${index === 0 ? "border-r border-white/[0.12]" : ""}`}
            >
              <div class="flex flex-col gap-2">
                <h3 class="text-white text-2xl font-heading font-medium leading-9">
                  {feature.title}
                </h3>
                <p class="text-white/60 text-lg font-body font-normal leading-7 whitespace-pre-line">
                  {feature.description}
                </p>
              </div>
              <div class="flex flex-col gap-2">
                <span class="text-primary text-[44px] font-heading font-medium leading-[54px]">
                  {feature.stat}
                </span>
                <span class="text-white/60 text-lg font-body font-normal leading-[26px]">
                  {feature.statLabel}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bottom CTA Hint -->
    <div class="text-center mt-12">
      <p class="text-sm text-gray-500">
        Same trades. Same strategy. <span class="text-primary font-semibold"
          >More profit.</span
        >
      </p>
    </div>
  </div>
</section>
