---
// Features — full-width horizontal borders, center vertical divider per Figma (1106:4425)
const features = [
  {
    title: "Passive Yield on Every Order",
    description: "Your limit orders automatically earn lending yield while waiting to fill.",
    stat: "12.5%",
    statLabel: "Avg APY",
  },
  {
    title: "Borrow from Your Portfolio",
    description: "No need to move assets around. Borrow instantly against your portfolio.",
    stat: "1-Click",
    statLabel: "Instant Borrow",
  },
  {
    title: "Soft Liquidations",
    description: "Positions are unwound gradually at the exact trigger price. No sudden wipeouts.",
    stat: "Gradual",
    statLabel: "Protection",
  },
  {
    title: "Auto-Repay Loans",
    description: "Yield generated automatically pays down your loans. Your debt shrinks while you sleep.",
    stat: "Auto",
    statLabel: "Repayment",
  },
];
---

<section class="py-24 relative overflow-hidden" id="features">
  <!-- Section Header -->
  <div class="section-container relative z-10 mb-16">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-display font-semibold mb-6 section-gradient-text">
        Built for Serious Traders
      </h2>
      <p class="text-lg font-body text-secondary">
        Every feature designed to maximize your capital efficiency and trading edge.
        Same trades. <strong class="text-white font-semibold">Same strategy. More profit.</strong>
      </p>
    </div>
  </div>

  <!-- Full-width table grid -->
  <div class="border-t border-[rgba(255,255,255,0.12)]">
    <div class="grid grid-cols-1 md:grid-cols-2">
      {features.map((feature, i) => (
        <div class:list={[
          'flex flex-col justify-between px-6 sm:px-12 lg:px-20 py-12 min-h-[260px]',
          'border-b border-[rgba(255,255,255,0.12)]',
          i % 2 === 0 ? 'md:border-r border-[rgba(255,255,255,0.12)]' : '',
        ]}>
          <!-- Title + Description -->
          <div class="space-y-3">
            <h3 class="text-lg lg:text-xl font-heading font-bold text-white">
              {feature.title}
            </h3>
            <p class="text-sm font-body text-white/50 leading-relaxed">
              {feature.description}
            </p>
          </div>

          <!-- Stat (bottom-left) -->
          <div class="mt-8">
            <div class="text-4xl lg:text-5xl font-heading font-black text-primary leading-none">
              {feature.stat}
            </div>
            <div class="text-xs font-body text-white/40 uppercase tracking-widest mt-2">
              {feature.statLabel}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-gradient-text {
    background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0.6) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
