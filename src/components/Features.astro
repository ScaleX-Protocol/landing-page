---
// Features section - Why Trade on ScaleX with bento grid layout
---

<section class="py-24 relative overflow-hidden" id="earn">
  <!-- Background Glow Effects -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-[-10%] left-[20%] w-[500px] h-[500px] bg-blue-900/20 rounded-full blur-[100px]"
    >
    </div>
    <div
      class="absolute top-[10%] right-[10%] w-[300px] h-[300px] bg-primary/10 rounded-full blur-[80px]"
    >
    </div>
  </div>

  <div class="section-container relative z-10">
    <!-- Hero Header Section -->
    <div
      class="flex flex-col items-center text-center mb-16 max-w-[960px] mx-auto"
    >
      <!-- Live Badge -->
      <div
        class="mb-8 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 transition-colors hover:bg-primary/20 backdrop-blur-sm shadow-[0_0_15px_rgba(249,115,22,0.3)]"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"
          ></span>
        </span>
        <span class="text-xs font-bold uppercase tracking-wide text-primary"
          >Live on Mainnet</span
        >
      </div>

      <!-- Main Headline -->
      <h1
        class="text-white text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-extrabold leading-tight tracking-[-0.03em] pb-6 drop-shadow-sm"
      >
        Unlock the Power of <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-light"
          >ScaleX</span
        >
      </h1>

      <!-- Description -->
      <p
        class="text-gray-400 text-base sm:text-lg md:text-xl max-w-2xl font-normal leading-relaxed"
      >
        Experience the next evolution of DeFi trading. Earn yield on active
        orders and trade with institutional-grade tools in a deep liquidity
        environment.
      </p>
    </div>

    <!-- Section Header - Why Trade on ScaleX? -->
    <div class="flex flex-col items-center mb-16 text-center">
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-br from-white via-gray-200 to-gray-500"
      >
        Why Trade on ScaleX?
      </h2>
      <div
        class="h-1.5 w-24 bg-gradient-to-r from-primary to-primary-dark rounded-full shadow-[0_0_20px_rgba(249,115,22,0.6)]"
      >
      </div>
    </div>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-[1200px] mx-auto">
      <!-- Large Card - Yield on Active Orders (spans 2 rows on left) -->
      <div
        class="group relative lg:col-span-5 lg:row-span-2 flex flex-col overflow-hidden rounded-3xl bg-surface-secondary border border-white/5 p-8 transition-all duration-500 hover:border-primary/50 hover:shadow-[0_0_60px_-15px_rgba(249,115,22,0.15)] hover:-translate-y-1"
      >
        <!-- Hover Gradient -->
        <div
          class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>
        <!-- Corner Glow -->
        <div
          class="absolute -right-24 -top-24 h-64 w-64 rounded-full bg-primary/10 blur-[80px] transition-all duration-500 group-hover:bg-primary/20"
        >
        </div>

        <div class="relative z-10 flex flex-col h-full justify-between">
          <div>
            <!-- Icon -->
            <div
              class="mb-8 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-surface-tertiary border border-white/10 text-primary shadow-inner transition-all duration-500 group-hover:scale-110 group-hover:bg-primary group-hover:text-white group-hover:rotate-3"
            >
              <svg
                class="w-8 h-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="23,6 13.5,15.5 8.5,10.5 1,18"></polyline>
                <polyline points="17,6 23,6 23,12"></polyline>
              </svg>
            </div>

            <!-- Content -->
            <h3
              class="mb-4 text-2xl md:text-3xl font-heading font-bold text-white leading-tight group-hover:text-primary transition-colors duration-300"
            >
              Yield on Active Orders
            </h3>
            <p
              class="text-gray-400 text-base md:text-lg leading-relaxed font-light"
            >
              Earn interest on your assets even while they are locked in limit
              orders. Never let your capital sit idle waiting for a fill.
            </p>
          </div>

          <!-- Animated Bar Chart -->
          <div
            class="relative mt-12 h-40 w-full rounded-xl bg-gradient-to-br from-white/5 to-transparent border border-white/5 p-6 flex items-end gap-3 overflow-hidden group-hover:border-primary/20 transition-colors"
          >
            <div
              class="w-1/4 bg-primary/20 h-[30%] rounded-t-sm transition-all duration-700 ease-out group-hover:h-[50%] group-hover:bg-primary/40"
            >
            </div>
            <div
              class="w-1/4 bg-primary/30 h-[50%] rounded-t-sm transition-all duration-700 delay-75 ease-out group-hover:h-[70%] group-hover:bg-primary/60"
            >
            </div>
            <div
              class="w-1/4 bg-primary/40 h-[40%] rounded-t-sm transition-all duration-700 delay-100 ease-out group-hover:h-[60%] group-hover:bg-primary/80"
            >
            </div>
            <div
              class="w-1/4 bg-primary/50 h-[70%] rounded-t-sm transition-all duration-700 delay-150 ease-out group-hover:h-[90%] group-hover:bg-primary shadow-[0_0_15px_rgba(249,115,22,0.5)]"
            >
            </div>
          </div>
        </div>
      </div>

      <!-- Card - Zero-Slippage Liquidations (top right) -->
      <div
        class="group relative lg:col-span-7 flex flex-col md:flex-row items-center gap-6 md:gap-8 overflow-hidden rounded-3xl bg-surface-secondary border border-white/5 p-8 lg:p-10 transition-all duration-500 hover:border-primary/50 hover:shadow-[0_0_60px_-15px_rgba(249,115,22,0.15)] hover:-translate-y-1"
      >
        <!-- Hover Gradient -->
        <div
          class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>

        <div class="relative shrink-0">
          <!-- Icon Glow -->
          <div
            class="absolute inset-0 bg-primary/20 blur-2xl rounded-full scale-50 opacity-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500"
          >
          </div>
          <!-- Icon -->
          <div
            class="relative flex h-16 w-16 md:h-20 md:w-20 items-center justify-center rounded-2xl bg-surface-tertiary border border-white/10 text-primary transition-all duration-500 group-hover:bg-primary group-hover:text-white group-hover:rotate-6 shadow-lg"
          >
            <svg
              class="w-8 h-8 md:w-10 md:h-10"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
        </div>

        <div class="relative z-10 text-center md:text-left flex-1">
          <h3
            class="mb-3 text-xl md:text-2xl font-heading font-bold text-white group-hover:text-primary transition-colors duration-300"
          >
            Zero-Slippage Liquidations
          </h3>
          <p
            class="text-gray-400 text-sm md:text-base leading-relaxed font-light"
          >
            Protect your portfolio with our advanced liquidation engine that
            ensures execution at the exact trigger price, every time. No hidden
            costs, just pure efficiency.
          </p>
        </div>

        <!-- Background Decorative Icon -->
        <div
          class="absolute right-0 bottom-0 opacity-10 group-hover:opacity-20 transition-opacity pointer-events-none"
        >
          <svg
            class="w-36 h-36 md:w-40 md:h-40 text-primary -rotate-12 translate-x-10 translate-y-10"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
      </div>

      <!-- Card - Smart Loan Repayment (bottom right) -->
      <div
        class="group relative lg:col-span-7 flex flex-col md:flex-row-reverse items-center gap-6 md:gap-8 overflow-hidden rounded-3xl bg-surface-secondary border border-white/5 p-8 lg:p-10 transition-all duration-500 hover:border-primary/50 hover:shadow-[0_0_60px_-15px_rgba(249,115,22,0.15)] hover:-translate-y-1"
      >
        <!-- Hover Gradient -->
        <div
          class="absolute inset-0 bg-gradient-to-l from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>

        <div class="relative shrink-0">
          <!-- Icon Glow -->
          <div
            class="absolute inset-0 bg-primary/20 blur-2xl rounded-full scale-50 opacity-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500"
          >
          </div>
          <!-- Icon -->
          <div
            class="relative flex h-16 w-16 md:h-20 md:w-20 items-center justify-center rounded-2xl bg-surface-tertiary border border-white/10 text-primary transition-all duration-500 group-hover:bg-primary group-hover:text-white group-hover:-rotate-6 shadow-lg"
          >
            <svg
              class="w-8 h-8 md:w-10 md:h-10"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
              <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
              <path d="M18 12a2 2 0 0 0 0 4h4v-4h-4z"></path>
            </svg>
          </div>
        </div>

        <div class="relative z-10 text-center md:text-right flex-1">
          <h3
            class="mb-3 text-xl md:text-2xl font-heading font-bold text-white group-hover:text-primary transition-colors duration-300"
          >
            Smart Loan Repayment
          </h3>
          <p
            class="text-gray-400 text-sm md:text-base leading-relaxed font-light"
          >
            Automated repayment strategies that optimize your collateral usage
            and minimize interest payments automatically. Let the protocol work
            for you.
          </p>
        </div>

        <!-- Background Decorative Icon -->
        <div
          class="absolute left-0 bottom-0 opacity-10 group-hover:opacity-20 transition-opacity pointer-events-none"
        >
          <svg
            class="w-36 h-36 md:w-40 md:h-40 text-primary rotate-12 -translate-x-10 translate-y-10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
            <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
            <path d="M18 12a2 2 0 0 0 0 4h4v-4h-4z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- CTA Button -->
    <div class="w-full flex justify-center pt-16">
      <a
        href="https://app.scalex.finance"
        class="relative bg-primary hover:bg-primary-dark text-white font-heading font-bold py-4 px-10 rounded-full text-lg transition-all transform hover:scale-105 shadow-[0_0_25px_rgba(249,115,22,0.5)] hover:shadow-[0_0_40px_rgba(249,115,22,0.7)] flex items-center gap-3 overflow-hidden group border border-white/10"
      >
        <span class="relative z-10">Start Trading Now</span>
        <svg
          class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
        <!-- Shimmer Effect -->
        <div
          class="absolute inset-0 -translate-x-full group-hover:animate-shimmer bg-gradient-to-r from-transparent via-white/20 to-transparent z-0"
        >
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }

  .group:hover .group-hover\:animate-shimmer {
    animation: shimmer 1.5s infinite;
  }
</style>
