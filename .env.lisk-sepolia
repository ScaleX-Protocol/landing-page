# Lisk Sepolia Landing Page Environment Variables
NODE_ENV=production

# Chain Configuration
PUBLIC_CHAIN_NAME=Lisk Sepolia Testnet
PUBLIC_CHAIN_ID=4202
PUBLIC_RPC_URL=https://rpc.sepolia.mantle.xyz
PUBLIC_BLOCK_EXPLORER_URL=https://explorer.sepolia.mantle.xyz

# Application Configuration
PUBLIC_APP_NAME=ScaleX Landing - Lisk Sepolia
PUBLIC_APP_DESCRIPTION=ScaleX - Institutional Grade DeFi Infrastructure on Lisk Sepolia
PUBLIC_DOMAIN=lisk-sepolia.scalex.money
PUBLIC_BASE_URL=https://lisk-sepolia.scalex.money
PUBLIC_APP_ENV=staging

# Frontend Application URLs
PUBLIC_APP_URL=https://lisk-sepolia-app.scalex.money
PUBLIC_TRADE_URL=https://lisk-sepolia-app.scalex.money/trade

# API Configuration
PUBLIC_API_URL=https://lisk-sepolia-indexer.scalex.money
PUBLIC_WS_API_URL=wss://lisk-sepolia-indexer.scalex.money/ws

# Feature Flags
PUBLIC_FEATURE_ANALYTICS=false
PUBLIC_FEATURE_SENTRY=false
PUBLIC_FEATURE_DEBUG=true

# Infrastructure
ACME_EMAIL=admin@scalex.money
REDIS_PASSWORD=lisk_sepolia_landing_redis_789

# Server Configuration
HOST=0.0.0.0
PORT=3000

# Docker
COMPOSE_PROJECT_NAME=scalex-lisk-sepolia-landing
CONTAINER_NAME=scalex-landing-lisk-sepolia

# Monitoring
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=3
