# Base Sepolia Landing Page Environment Variables
NODE_ENV=production

# Chain Configuration
PUBLIC_CHAIN_NAME=Base Sepolia
PUBLIC_CHAIN_ID=84532
PUBLIC_RPC_URL=https://sepolia.base.org
PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# Application Configuration
PUBLIC_APP_NAME=ScaleX Landing - Base Sepolia
PUBLIC_APP_DESCRIPTION=ScaleX - Institutional Grade DeFi Infrastructure on Base Sepolia
PUBLIC_DOMAIN=base-sepolia.scalex.money
PUBLIC_BASE_URL=https://base-sepolia.scalex.money
PUBLIC_APP_ENV=staging

# Frontend Application URLs
PUBLIC_APP_URL=https://base-sepolia-app.scalex.money
PUBLIC_TRADE_URL=https://base-sepolia-app.scalex.money/trade

# API Configuration
PUBLIC_API_URL=https://base-sepolia-indexer.scalex.money
PUBLIC_WS_API_URL=wss://base-sepolia-indexer.scalex.money/ws

# Feature Flags
PUBLIC_FEATURE_ANALYTICS=false
PUBLIC_FEATURE_SENTRY=false
PUBLIC_FEATURE_DEBUG=true

# Infrastructure
ACME_EMAIL=admin@scalex.money
REDIS_PASSWORD=base_sepolia_landing_redis_123

# Server Configuration
HOST=0.0.0.0
PORT=3000

# Docker
COMPOSE_PROJECT_NAME=scalex-base-sepolia-landing
CONTAINER_NAME=scalex-landing-base-sepolia

# Monitoring
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=3