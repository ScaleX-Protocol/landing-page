# Base Sepolia Landing Page Environment Variables
NODE_ENV=production

# Chain Configuration
NEXT_PUBLIC_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# Application Configuration
NEXT_PUBLIC_APP_NAME=ScaleX Landing - Base Sepolia
NEXT_PUBLIC_APP_DESCRIPTION=ScaleX - Institutional Grade DeFi Infrastructure on Base Sepolia
NEXT_PUBLIC_DOMAIN=base-sepolia.scalex.money
NEXT_PUBLIC_BASE_URL=https://base-sepolia.scalex.money
NEXT_PUBLIC_APP_ENV=staging

# Frontend Application URLs
NEXT_PUBLIC_APP_URL=https://base-sepolia-app.scalex.money
NEXT_PUBLIC_TRADE_URL=https://base-sepolia-app.scalex.money/trade

# API Configuration
NEXT_PUBLIC_API_URL=https://base-sepolia-indexer.scalex.money
NEXT_PUBLIC_WS_API_URL=wss://base-sepolia-indexer.scalex.money/ws

# Feature Flags
NEXT_PUBLIC_FEATURE_ANALYTICS=false
NEXT_PUBLIC_FEATURE_SENTRY=false
NEXT_PUBLIC_FEATURE_DEBUG=true

# Infrastructure
ACME_EMAIL=admin@scalex.money
REDIS_PASSWORD=base_sepolia_landing_redis_123

# Ports
PORT=3000
NGINX_PORT=80
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# Docker
COMPOSE_PROJECT_NAME=scalex-base-sepolia-landing
CONTAINER_NAME=scalex-landing-base-sepolia

# Monitoring
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=3